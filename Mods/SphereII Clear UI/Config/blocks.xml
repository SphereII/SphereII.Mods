<configs>
  <!-- Enables the disable XP notification, but disable the unlock enemy health bar. -->
  <set xpath="/blocks/block[@name='ConfigFeatureBlock']/property[@class='AdvancedUI']/property[@name='DisableXPIconNotification']/@value">true</set>
  <!-- SCore's AdvancedUI property is ShowTargetHealthBar; "UnlockEnemyHealthBar" exists nowhere
       in SCore, so this set has never matched anything. -->
  <set xpath="/blocks/block[@name='ConfigFeatureBlock']/property[@class='AdvancedUI']/property[@name='ShowTargetHealthBar']/@value">false</set>
</configs>