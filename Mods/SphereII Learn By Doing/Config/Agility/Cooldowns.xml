<configs>
    <append xpath="/buffs">

        <!-- Agility LBD Supporting Buffs -->

        <!-- Cooldown for attAgility -->
        <buff name="buffLBD_attAgility_XPCoolDown" hidden="true"><duration value="1"/></buff>
        <!-- Movement awards tick on their own, longer throttle so walking cannot
             outpace deliberate activity. The combat, harvesting and crafting awards
             for this progression keep the 1s rate above. -->
        <buff name="buffLBD_attAgility_MoveCoolDown" hidden="true"><duration value="10"/></buff>

        <!-- Cooldown for perkArchery -->
        <buff name="buffLBD_perkArchery_XPCoolDown" hidden="true"><duration value="1"/></buff>

        <!-- Cooldown for perkGunslinger -->
        <buff name="buffLBD_perkGunslinger_XPCoolDown" hidden="true"><duration value="1"/></buff>

        <!-- Cooldown for perkDeepCuts -->
        <buff name="buffLBD_perkDeepCuts_XPCoolDown" hidden="true"><duration value="1"/></buff>

        <!-- Cooldown for perkParkour -->
        <buff name="buffLBD_perkParkour_XPCoolDown" hidden="true"><duration value="2"/></buff>

        <!-- Cooldown for perkLightArmor -->
        <buff name="buffLBD_perkLightArmor_XPCoolDown" hidden="true"><duration value="1"/></buff>

        <!-- Cooldowns for perkMediumArmor and perkHeavyArmor. Both were referenced by
             their perk files but never defined, so NotHasBuff was always true and the
             AddBuff was a no-op: every hit taken scored, with no throttle at all.
             Matched to the Light Armor sibling above. -->
        <buff name="buffLBD_perkMediumArmor_XPCoolDown" hidden="true"><duration value="1"/></buff>
        <!-- Movement awards tick on their own, longer throttle so walking cannot
             outpace deliberate activity. The combat, harvesting and crafting awards
             for this progression keep the 1s rate above. -->
        <buff name="buffLBD_perkMediumArmor_MoveCoolDown" hidden="true"><duration value="10"/></buff>
        <buff name="buffLBD_perkHeavyArmor_XPCoolDown" hidden="true"><duration value="1"/></buff>

        <!-- Cooldown for perkRunAndGun -->
        <buff name="buffLBD_perkRunAndGun_XPCoolDown" hidden="true"><duration value="1"/></buff>

        <!-- Cooldown for perkHiddenStrike -->
        <buff name="buffLBD_perkHiddenStrike_XPCoolDown" hidden="true"><duration value="1"/></buff>

        <!-- Cooldown for perkHardTarget. Referenced but never defined, so the perk
             scored on every hit taken with no throttle. -->
        <buff name="buffLBD_perkHardTarget_XPCoolDown" hidden="true"><duration value="1"/></buff>

        <!-- Cooldown for perkFromTheShadows -->
        <!-- Movement triggers fire continuously, so this duration is the XP tick rate.
             At 1s this was among the fastest progressions in the mod on walking
             alone. 10s matches Healing Factor's long standing movement throttle. -->
        <buff name="buffLBD_perkFromTheShadows_XPCoolDown" hidden="true"><duration value="10"/></buff>

        <!-- Special Mechanic Buff for perkFlurryOfAgility -->
        <buff name="buffLBD_Flurry_ComboWindow_Agility" hidden="true">
            <stack_type value="replace"/>
            <duration value="2"/>
        </buff>

        <!-- Cooldown for perkFlurryOfAgility -->
        <buff name="buffLBD_perkFlurryOfAgility_XPCoolDown" hidden="true"><duration value="1"/></buff>

        <!-- Cooldown for perkAgilityMastery -->
        <buff name="buffLBD_perkAgilityMastery_CombatCoolDown" hidden="true"><duration value="1"/></buff>
        <buff name="buffLBD_perkAgilityMastery_MovementCoolDown" hidden="true"><duration value="1"/></buff>

    </append>
</configs>