<configs>
    <!-- Append the initializers for the Agility LBD system to the global Init buff. -->
    <append xpath="/buffs/buff[@name='ProgressionLearnByDoing_Init']">
        <effect_group name="Agility Initializers">

            <!-- Apply the permanent Agility Manager Buff to the player -->
            <triggered_effect trigger="onSelfBuffStart" action="AddBuff" buff="buffLBD_AgilityManager"/>

            <!-- Initializers for Agility CVars -->

            <!-- attAgility -->
            <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$attagility_lbd_xp" operation="set" value="0"/>
            <!-- Attribute first threshold. Was 5000, which at the ~10 XP/min a real session
                 produces meant 8 hours for level 1 and about 209 hours to reach 10 -
                 nearly seven times what maxing a five level perk costs, despite
                 attributes accruing faster from their seven to nine award paths. At
                 1200, the same number every perk uses, level 1 lands in under two
                 hours and the full ten levels total 31,150, still three and a half
                 times a perk's whole ladder. The 1.2 curve is global and unchanged. -->
            <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$attagility_lbd_xptonext" operation="set" value="1200"/>

            <!-- perkArchery -->
            <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$perkarchery_lbd_xp" operation="set" value="0"/>
            <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$perkarchery_lbd_xptonext" operation="set" value="1200"/>

            <!-- perkGunslinger -->
            <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$perkgunslinger_lbd_xp" operation="set" value="0"/>
            <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$perkgunslinger_lbd_xptonext" operation="set" value="1200"/>

            <!-- perkDeepCuts -->
            <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$perkdeepcuts_lbd_xp" operation="set" value="0"/>
            <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$perkdeepcuts_lbd_xptonext" operation="set" value="1200"/>

            <!-- perkParkour -->
            <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$perkparkour_lbd_xp" operation="set" value="0"/>
            <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$perkparkour_lbd_xptonext" operation="set" value="1200"/>

            <!-- perkhardTarget -->
            <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$perkhardtarget_lbd_xp" operation="set" value="0"/>
            <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$perkhardtarget_lbd_xptonext" operation="set" value="1200"/>

            <!-- perkRunAndGun -->
            <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$perkrunandgun_lbd_xp" operation="set" value="0"/>
            <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$perkrunandgun_lbd_xptonext" operation="set" value="1200"/>

            <!-- perkHiddenStrike -->
            <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$perkhiddenstrike_lbd_xp" operation="set" value="0"/>
            <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$perkhiddenstrike_lbd_xptonext" operation="set" value="1200"/>

            <!-- perkFromTheShadows -->
            <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$perkfromtheshadows_lbd_xp" operation="set" value="0"/>
            <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$perkfromtheshadows_lbd_xptonext" operation="set" value="1200"/>

            <!-- perkFlurryOfAgility -->
            <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$perkflurryofagility_lbd_xp" operation="set" value="0"/>
            <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$perkflurryofagility_lbd_xptonext" operation="set" value="1200"/>

            <!-- perkAgilityMastery -->
            <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$perkagilitymastery_lbd_xp" operation="set" value="0"/>
            <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$perkagilitymastery_lbd_xptonext" operation="set" value="3000"/>

        </effect_group>
    </append>
</configs>