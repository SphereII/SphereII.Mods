<configs>
    <append xpath="/buffs">

        <!-- Fortitude LBD Supporting Buffs -->

        <!-- Cooldown for attFortitude -->
        <buff name="buffLBD_attFortitude_XPCoolDown" hidden="true"><duration value="1"/></buff>
        <!-- Movement awards tick on their own, longer throttle so walking cannot
             outpace deliberate activity. The combat, harvesting and crafting awards
             for this progression keep the 1s rate above. -->
        <buff name="buffLBD_attFortitude_MoveCoolDown" hidden="true"><duration value="10"/></buff>

        <!-- Cooldown for perkBrawler -->
        <buff name="buffLBD_perkBrawler_XPCoolDown" hidden="true"><duration value="1"/></buff>

        <!-- Cooldown for perkMachineGunner -->
        <buff name="buffLBD_perkMachineGunner_XPCoolDown" hidden="true"><duration value="1"/></buff>

        <!-- Cooldown for perkFlurryOfFortitude -->
        <buff name="buffLBD_Flurry_ComboWindow_Fortitude" hidden="true">
            <stack_type value="replace"/>
            <duration value="2"/>
        </buff>

        <!-- Cooldown for perkTheHuntsman -->
        <buff name="buffLBD_perkTheHuntsman_XPCoolDown" hidden="true"><duration value="5"/></buff>

        <!-- Cooldown for perkSiphoningStrikes -->
        <buff name="buffLBD_perkSiphoningStrikes_XPCoolDown" hidden="true"><duration value="1"/></buff>

        <!-- Cooldowns for perkPainTolerance -->
        <buff name="buffLBD_perkPainTolerance_DamageCoolDown" hidden="true"><duration value="1"/></buff>
        <buff name="buffLBD_perkPainTolerance_StunCoolDown" hidden="true"><duration value="5"/></buff>
        <buff name="buffLBD_perkPainTolerance_ConcussionCoolDown" hidden="true"><duration value="60"/></buff>
        <buff name="buffLBD_perkPainTolerance_ConcussionChecker" hidden="true"><duration value="0.1"/></buff>

        <!-- Cooldown for perkHealingFactor -->
        <buff name="buffLBD_perkHealingFactor_XPCoolDown" hidden="true"><duration value="10"/></buff>
        <!-- Health regenerates on a tick, so the heal path needs its own, longer throttle. -->
        <buff name="buffLBD_perkHealingFactor_HealCoolDown" hidden="true"><duration value="15"/></buff>

        <!-- Cooldowns for perkSlowMetabolism -->
        <buff name="buffLBD_perkSlowMetabolism_ConsumeCoolDown" hidden="true"><duration value="10"/></buff>
        <buff name="buffLBD_perkSlowMetabolism_RecoveryCoolDown" hidden="true"><duration value="600"/></buff>
        <!-- buffLBD_perkSlowMetabolism_ConsumeChecker is NOT declared here.

             It used to be, as an empty 0.1s stub, while SlowMetabolism.xml declared a buff
             of the same name carrying all of the actual logic - the dysentery, food and
             water awards, the cooldown, and the level up check. main.xml includes
             Cooldowns.xml AFTER SlowMetabolism.xml, so this stub was the later of two
             same-named declarations and stood a good chance of shadowing the real one.

             Even a harmless duplicate is worth removing here: it makes the buff look
             defined when the definition that matters lives elsewhere, which is how the
             missing AddBuff went unnoticed for so long. One name, one declaration, in the
             file that owns the perk.

             RecoveryCoolDown above and RecoveryChecker (removed with it) are referenced by
             nothing at all - leftovers from a "recover from dysentery" path that was never
             written. RecoveryCoolDown is kept only because it is harmless and may yet be
             wired up; the checker stub is not, for the shadowing reason above. -->


        <!-- Cooldown for perkRuleOneCardio -->
        <!-- Movement triggers fire continuously, so this duration is the XP tick rate.
             At 1s this was among the fastest progressions in the mod on walking
             alone. 10s matches Healing Factor's long standing movement throttle. -->
        <buff name="buffLBD_perkRuleOneCardio_XPCoolDown" hidden="true"><duration value="10"/></buff>

    </append>
</configs>