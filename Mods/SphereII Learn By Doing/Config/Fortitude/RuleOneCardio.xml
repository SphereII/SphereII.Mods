<configs>
    <append xpath="/buffs/buff[@name='buffLBD_FortitudeManager']">
        <effect_group name="Rule #1: Cardio">
            <!-- Cardio is exertion, not travel. The onSelfWalk and onSelfCrouchWalk
                 paths are gone, and the movement gate below drops the strolling tags to
                 match: walking, crouching and slow swimming no longer count. Walking was
                 42 percent of this perk's XP in a logged session purely from getting
                 around. -->
            <requirements compare_type="or">
                <requirement name="EntityHasMovementTag" tags="running"/>
                <requirement name="EntityHasMovementTag" tags="swimmingRun"/>
                <requirement name="EntityHasMovementTag" tags="crouchRun"/>
            </requirements>

            <triggered_effect trigger="onSelfRun" action="LogMessageCVars, SCore" message="LBD DEBUG: Rule #1: Cardio (Run) - Attempting XP Gain (+@$lbd_xp_attribute_synergy_base)">
                <requirement name="NotHasBuff" buff="buffLBD_perkRuleOneCardio_XPCoolDown"/>
                <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfRun" action="ModifyCVar" cvar="$perkruleonecardio_lbd_xp" operation="add" value="@$lbd_xp_attribute_synergy_base">
                <requirement name="NotHasBuff" buff="buffLBD_perkRuleOneCardio_XPCoolDown"/>
            </triggered_effect>


            <triggered_effect trigger="onSelfCrouchRun" action="LogMessageCVars, SCore" message="LBD DEBUG: Rule #1: Cardio (Crouch Run) - Attempting XP Gain (+@$lbd_xp_attribute_synergy_base)">
                <requirement name="NotHasBuff" buff="buffLBD_perkRuleOneCardio_XPCoolDown"/>
                <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfCrouchRun" action="ModifyCVar" cvar="$perkruleonecardio_lbd_xp" operation="add" value="@$lbd_xp_attribute_synergy_base">
                <requirement name="NotHasBuff" buff="buffLBD_perkRuleOneCardio_XPCoolDown"/>
            </triggered_effect>


            <triggered_effect trigger="onSelfRun" action="AddBuff" buff="buffLBD_perkRuleOneCardio_XPCoolDown">
                <requirement name="NotHasBuff" buff="buffLBD_perkRuleOneCardio_XPCoolDown"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfCrouchRun" action="AddBuff" buff="buffLBD_perkRuleOneCardio_XPCoolDown">
                <requirement name="NotHasBuff" buff="buffLBD_perkRuleOneCardio_XPCoolDown"/>
            </triggered_effect>

            <triggered_effect trigger="onSelfRun" action="AddBuff" buff="buffLBD_perkRuleOneCardio_LevelUpCheck">
                <requirement name="CVarCompare" cvar="$perkruleonecardio_lbd_xp" operation="GTE" value="@$perkruleonecardio_lbd_xptonext"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfCrouchRun" action="AddBuff" buff="buffLBD_perkRuleOneCardio_LevelUpCheck">
                <requirement name="CVarCompare" cvar="$perkruleonecardio_lbd_xp" operation="GTE" value="@$perkruleonecardio_lbd_xptonext"/>
            </triggered_effect>
</effect_group>
    </append>

    <append xpath="/buffs">
        <buff name="buffLBD_perkRuleOneCardio_LevelUpCheck" hidden="true">
            <stack_type value="ignore"/><duration value="1"/>
            <effect_group>
                <requirement name="CanPurchasePerk, SCore" progression_name="perkRuleOneCardio" />
                <triggered_effect trigger="onSelfBuffStart" action="LogMessageCVars, SCore" message="LBD DEBUG: Rule One: Cardio - Level Up SUCCESS (perkRuleOneCardio)">
                    <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
                </triggered_effect>
                <triggered_effect trigger="onSelfBuffStart" action="AddProgressionLevel" progression_name="perkRuleOneCardio" level="1"/>
                <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$perkruleonecardio_lbd_xp" operation="subtract" value="@$perkruleonecardio_lbd_xptonext"/>
                <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$perkruleonecardio_lbd_xptonext" operation="multiply" value="@$lbd_xp_curve_multiplier"/>
                <triggered_effect trigger="onSelfBuffStart" action="ShowToolbeltMessage" message_key="perkRuleOneCardioLeveledUp"/>
            </effect_group>
            <effect_group>
                <requirement name="!CanPurchasePerk, SCore" progression_name="perkRuleOneCardio" />
                <triggered_effect trigger="onSelfBuffStart" action="LogMessageCVars, SCore" message="LBD DEBUG: Rule One: Cardio - Level Up FAILED. Perk is locked by requirements.">
                    <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
                </triggered_effect>
            </effect_group>
        </buff>
 
    </append>
</configs>