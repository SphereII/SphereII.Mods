<configs>
    <append xpath="//item[@name='drinkJarGrandpasForgettingElixir']/effect_group">
        <triggered_effect trigger="onSelfPrimaryActionEnd" action="AddBuff" buff="ProgressionLearnByDoing_Init" />
    </append>

    <!-- LBD decay resets that need proof the item was actually used up.

         These sit on the items, not the player. When an item is eaten, read or applied, the
         game fires onSelfPrimaryActionEnd on that item's own effects (ItemActionEat:
         stack.itemValue.FireEvent(...)), the same way a magazine's own AddProgressionLevel
         runs. A player-level onSelfPrimaryActionEnd is also raised by melee swings without
         setting the event's item, so a reset there could fire on a swing long after the
         last meal, bandage or magazine.

         Effects are parsed from each item's own node and are not inherited through Extends,
         so the medical and food patches also name the vanilla items that take their Tags from
         a parent. A modded item that inherits its food or medical tag without declaring Tags
         will not be matched. The names are listed rather than matched through Extends because
         an XPath that follows Extends compares node-sets and is slow on every game load. -->

    <!-- Reading this skill's magazine keeps craftingArmor sharp. -->
    <append xpath="/items/item[property[@name='Unlocks' and @value='craftingArmor']]">
        <effect_group name="LBD Decay Reset" tiered="false">
            <triggered_effect trigger="onSelfPrimaryActionEnd" action="ModifyCVar" cvar="$craftingarmor_decay_counter" operation="set" value="0"/>
        </effect_group>
    </append>
