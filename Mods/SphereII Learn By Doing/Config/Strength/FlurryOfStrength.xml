<configs>
    <!-- Append the LBD logic for Flurry of Strength to the main Strength Manager buff. -->
    <append xpath="/buffs/buff[@name='buffLBD_StrengthManager']">
        <effect_group name="Flurry of Strength">
            <requirement name="HoldingItemHasTags" tags="perkPummelPete,perkSkullCrusher"/>
            <requirement name="IsAlive" target="other"/>

            <triggered_effect trigger="onSelfPrimaryActionRayHit" action="ModifyCVar" cvar="$perkflurryofstrength_lbd_xp" operation="add" value="@$lbd_xp_flurry_bonus">
                <requirement name="HasBuff" buff="buffLBD_Flurry_ComboWindow_Strength"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfSecondaryActionRayHit" action="ModifyCVar" cvar="$perkflurryofstrength_lbd_xp" operation="add" value="@$lbd_xp_flurry_bonus">
                <requirement name="HasBuff" buff="buffLBD_Flurry_ComboWindow_Strength"/>
            </triggered_effect>

            <triggered_effect trigger="onSelfPrimaryActionRayHit" action="AddBuff" buff="buffLBD_Flurry_ComboWindow_Strength"/>
            <triggered_effect trigger="onSelfSecondaryActionRayHit" action="AddBuff" buff="buffLBD_Flurry_ComboWindow_Strength"/>

            <triggered_effect trigger="onSelfPrimaryActionRayHit" action="AddBuff" buff="buffLBD_perkFlurryOfStrength_LevelUpCheck">
                <requirement name="CVarCompare" cvar="$perkflurryofstrength_lbd_xp" operation="GTE" value="@$perkflurryofstrength_lbd_xptonext"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfSecondaryActionRayHit" action="AddBuff" buff="buffLBD_perkFlurryOfStrength_LevelUpCheck">
                <requirement name="CVarCompare" cvar="$perkflurryofstrength_lbd_xp" operation="GTE" value="@$perkflurryofstrength_lbd_xptonext"/>
            </triggered_effect>

            <triggered_effect trigger="onSelfPrimaryActionRayHit" action="LogMessageCVars, SCore" message="LBD DEBUG: Flurry of Strength Primary - COMBO HIT! Applying Bonus XP (+@$lbd_xp_flurry_bonus)">
                <requirement name="HasBuff" buff="buffLBD_Flurry_ComboWindow_Strength"/>
                <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfSecondaryActionRayHit" action="LogMessageCVars, SCore" message="LBD DEBUG: Flurry of Strength Power - COMBO HIT! Applying Bonus XP (+@$lbd_xp_flurry_bonus)">
                <requirement name="HasBuff" buff="buffLBD_Flurry_ComboWindow_Strength"/>
                <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfPrimaryActionRayHit" action="LogMessageCVars, SCore" message="LBD DEBUG: Flurry of Strength Primary - Starting/Refreshing Combo Window">
                <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfSecondaryActionRayHit" action="LogMessageCVars, SCore" message="LBD DEBUG: Flurry of Strength Power - Starting/Refreshing Combo Window">
                <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
            </triggered_effect>
        </effect_group>
    </append>

    <!-- Define the Level-Up Handler and the Combo Window buff. -->
    <append xpath="/buffs">
        <!-- The temporary buff that creates the combo window. 'stack_type="replace"' is CRITICAL. -->
        <buff name="buffLBD_Flurry_ComboWindow_Strength" hidden="true">
            <stack_type value="replace"/>
            <duration value="2"/>
        </buff>

        <buff name="buffLBD_perkFlurryOfStrength_LevelUpCheck" hidden="true">
            <stack_type value="ignore"/><duration value="1"/>
            <effect_group>
                <requirement name="CanPurchasePerk, SCore" progression_name="perkFlurryOfStrength" />
                <triggered_effect trigger="onSelfBuffStart" action="LogMessageCVars, SCore" message="LBD DEBUG: Flurry of Strength - Level Up SUCCESS (perkFlurryOfStrength)">
                    <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
                </triggered_effect>
                <triggered_effect trigger="onSelfBuffStart" action="AddProgressionLevel" progression_name="perkFlurryOfStrength" level="1"/>
                <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$perkflurryofstrength_lbd_xp" operation="subtract" value="@$perkflurryofstrength_lbd_xptonext"/>
                <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$perkflurryofstrength_lbd_xptonext" operation="multiply" value="@$lbd_xp_curve_multiplier"/>
                <triggered_effect trigger="onSelfBuffStart" action="ShowToolbeltMessage" message_key="perkFlurryOfStrengthLeveledUp"/>
            </effect_group>
            <effect_group>
                <requirement name="!CanPurchasePerk, SCore" progression_name="perkFlurryOfStrength" />
                <triggered_effect trigger="onSelfBuffStart" action="LogMessageCVars, SCore" message="LBD DEBUG: Flurry of Strength - Level Up FAILED. Perk is locked by requirements.">
                    <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
                </triggered_effect>
            </effect_group>
        </buff>
    </append>
</configs>