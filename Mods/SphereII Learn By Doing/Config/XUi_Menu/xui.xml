<configs>

	<!--
		Register the Learn By Doing info panel with the main menu.

		A window only ever appears as part of a window_group, and the main menu group
		already carries four of them (mainMenu, mainMenuVersion, mainMenuPlayerName,
		mainMenuNews). Appending a fifth means it opens and closes with the menu with
		no controller work needed. The window itself is defined in XUi_Menu/windows.xml.

		The group's defaultselected="btnPlayGame" is untouched - the panel holds no
		selectable controls, so it never enters gamepad navigation.
	-->
	<append xpath="/xui/window_group[@name='mainMenu']">
		<window name="mainMenuLearnByDoing" />
	</append>

</configs>