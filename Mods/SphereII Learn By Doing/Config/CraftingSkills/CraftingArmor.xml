<configs>
    <append xpath="/buffs/buff[@name='buffLBD_GeneralManager']">
        <effect_group name="LBD Crafting Skill - Armor">
            <triggered_effect trigger="onSelfItemCrafted" action="LogMessageCVars, SCore" message="LBD DEBUG: Crafting Armor - Attempting 'Craft' XP (+@$lbd_xp_crafting_base)">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingArmor"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingArmor_ActionCoolDown"/>
                <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
                <requirement name="!RequirementCraftedItemMatchesCVar, SCore" cvar="$craftingarmor_lbd_lastitem"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfItemCrafted" action="ModifyCVar" cvar="$craftingarmor_lbd_xp" operation="add" value="@$lbd_xp_crafting_base">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingArmor"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingArmor_ActionCoolDown"/>
                <requirement name="!RequirementCraftedItemMatchesCVar, SCore" cvar="$craftingarmor_lbd_lastitem"/>
            </triggered_effect>

            <triggered_effect trigger="onSelfScrapItem" action="LogMessageCVars, SCore" message="LBD DEBUG: Crafting Armor - Attempting 'Scrap' XP (+@$lbd_xp_scrapping_base)">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingArmor"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingArmor_ActionCoolDown"/>
                <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfScrapItem" action="ModifyCVar" cvar="$craftingarmor_lbd_xp" operation="add" value="@$lbd_xp_scrapping_base">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingArmor"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingArmor_ActionCoolDown"/>
            </triggered_effect>

            <triggered_effect trigger="onSelfItemRepaired" action="LogMessageCVars, SCore" message="LBD DEBUG: Crafting Armor - Attempting 'Repair' XP (+@$lbd_xp_repairing_base)">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingArmor"/>
                <requirement name="ItemPercentDamaged, SCore" operation="GTE" value="0.5"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingArmor_ActionCoolDown"/>
                <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfItemRepaired" action="ModifyCVar" cvar="$craftingarmor_lbd_xp" operation="add" value="@$lbd_xp_repairing_base">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingArmor"/>
                <requirement name="ItemPercentDamaged, SCore" operation="GTE" value="0.5"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingArmor_ActionCoolDown"/>
            </triggered_effect>

            <triggered_effect trigger="onSelfItemRepaired" action="LogMessageCVars, SCore" message="LBD DEBUG: Crafting Armor - Attempting T0 Repair XP (+@$lbd_xp_repairing_base)">
                <requirement name="ProgressionLevel" progression_name="craftingArmor" operation="LTE" value="10"/>
                <requirement name="ItemHasProperty, SCore" property="ArmorGroup" prop_value="groupPrimitive"/>
                <requirement name="ItemPercentDamaged, SCore" operation="GTE" value="0.5"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingArmor_T0RepairCoolDown"/>
                <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfItemRepaired" action="ModifyCVar" cvar="$craftingarmor_lbd_xp" operation="add" value="@$lbd_xp_repairing_base">
                <requirement name="ProgressionLevel" progression_name="craftingArmor" operation="LTE" value="10"/>
                <requirement name="ItemHasProperty, SCore" property="ArmorGroup" prop_value="groupPrimitive"/>
                <requirement name="ItemPercentDamaged, SCore" operation="GTE" value="0.5"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingArmor_T0RepairCoolDown"/>
            </triggered_effect>

            <triggered_effect trigger="onSelfItemCrafted" action="LogMessageCVars, SCore" message="LBD DEBUG: Crafting Armor - Applying Cooldown (Craft)">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingArmor"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingArmor_ActionCoolDown"/>
                <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfItemCrafted" action="AddBuff" buff="buffLBD_craftingArmor_ActionCoolDown">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingArmor"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingArmor_ActionCoolDown"/>
            </triggered_effect>

            <triggered_effect trigger="onSelfScrapItem" action="LogMessageCVars, SCore" message="LBD DEBUG: Crafting Armor - Applying Cooldown (Scrap)">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingArmor"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingArmor_ActionCoolDown"/>
                <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfScrapItem" action="AddBuff" buff="buffLBD_craftingArmor_ActionCoolDown">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingArmor"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingArmor_ActionCoolDown"/>
            </triggered_effect>

            <triggered_effect trigger="onSelfItemRepaired" action="LogMessageCVars, SCore" message="LBD DEBUG: Crafting Armor - Applying Cooldown (Repair)">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingArmor"/>
                <requirement name="ItemPercentDamaged, SCore" operation="GTE" value="0.5"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingArmor_ActionCoolDown"/>
                <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfItemRepaired" action="AddBuff" buff="buffLBD_craftingArmor_ActionCoolDown">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingArmor"/>
                <requirement name="ItemPercentDamaged, SCore" operation="GTE" value="0.5"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingArmor_ActionCoolDown"/>
            </triggered_effect>

            <triggered_effect trigger="onSelfItemRepaired" action="AddBuff" buff="buffLBD_craftingArmor_T0RepairCoolDown">
                <requirement name="ProgressionLevel" progression_name="craftingArmor" operation="LTE" value="10"/>
                <requirement name="ItemHasProperty, SCore" property="ArmorGroup" prop_value="groupPrimitive"/>
                <requirement name="ItemPercentDamaged, SCore" operation="GTE" value="0.5"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingArmor_T0RepairCoolDown"/>
            </triggered_effect>

            <triggered_effect trigger="onSelfItemCrafted" action="LogMessageCVars, SCore" message="LBD DEBUG: Crafting Armor - Triggering Level Up Check (Craft)">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingArmor"/>
                <requirement name="CVarCompare" cvar="$craftingarmor_lbd_xp" operation="GTE" value="@$craftingarmor_lbd_xptonext"/>
                <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfItemCrafted" action="AddBuff" buff="buffLBD_craftingArmor_LevelUpCheck">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingArmor"/>
                <requirement name="CVarCompare" cvar="$craftingarmor_lbd_xp" operation="GTE" value="@$craftingarmor_lbd_xptonext"/>
            </triggered_effect>

            <triggered_effect trigger="onSelfScrapItem" action="LogMessageCVars, SCore" message="LBD DEBUG: Crafting Armor - Triggering Level Up Check (Scrap)">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingArmor"/>
                <requirement name="CVarCompare" cvar="$craftingarmor_lbd_xp" operation="GTE" value="@$craftingarmor_lbd_xptonext"/>
                <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfScrapItem" action="AddBuff" buff="buffLBD_craftingArmor_LevelUpCheck">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingArmor"/>
                <requirement name="CVarCompare" cvar="$craftingarmor_lbd_xp" operation="GTE" value="@$craftingarmor_lbd_xptonext"/>
            </triggered_effect>

            <triggered_effect trigger="onSelfItemRepaired" action="LogMessageCVars, SCore" message="LBD DEBUG: Crafting Armor - Triggering Level Up Check (Repair)">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingArmor"/>
                <requirement name="ItemPercentDamaged, SCore" operation="GTE" value="0.5"/>
                <requirement name="CVarCompare" cvar="$craftingarmor_lbd_xp" operation="GTE" value="@$craftingarmor_lbd_xptonext"/>
                <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfItemRepaired" action="AddBuff" buff="buffLBD_craftingArmor_LevelUpCheck">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingArmor"/>
                <requirement name="ItemPercentDamaged, SCore" operation="GTE" value="0.5"/>
                <requirement name="CVarCompare" cvar="$craftingarmor_lbd_xp" operation="GTE" value="@$craftingarmor_lbd_xptonext"/>
            </triggered_effect>

            <triggered_effect trigger="onSelfItemRepaired" action="LogMessageCVars, SCore" message="LBD DEBUG: Crafting Armor - Triggering Level Up Check (T0 Repair)">
                <requirement name="ProgressionLevel" progression_name="craftingArmor" operation="LTE" value="10"/>
                <requirement name="ItemHasProperty, SCore" property="ArmorGroup" prop_value="groupPrimitive"/>
                <requirement name="ItemPercentDamaged, SCore" operation="GTE" value="0.5"/>
                <requirement name="CVarCompare" cvar="$craftingarmor_lbd_xp" operation="GTE" value="@$craftingarmor_lbd_xptonext"/>
                <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfItemRepaired" action="AddBuff" buff="buffLBD_craftingArmor_LevelUpCheck">
                <requirement name="ProgressionLevel" progression_name="craftingArmor" operation="LTE" value="10"/>
                <requirement name="ItemHasProperty, SCore" property="ArmorGroup" prop_value="groupPrimitive"/>
                <requirement name="ItemPercentDamaged, SCore" operation="GTE" value="0.5"/>
                <requirement name="CVarCompare" cvar="$craftingarmor_lbd_xp" operation="GTE" value="@$craftingarmor_lbd_xptonext"/>
            </triggered_effect>
            <!-- Remember what was just crafted. Ordered last so the awards above
                 compare against the PREVIOUS craft, not this one. A queue of twenty
                 identical items now scores once; twenty different items score twenty
                 times. A cooldown cannot make that distinction - when an item takes
                 longer to craft than the cooldown lasts, every craft in the queue
                 scores regardless. -->
            <triggered_effect trigger="onSelfItemCrafted" action="SetCVarFromItemType, SCore" cvar="$craftingarmor_lbd_lastitem"/>

        </effect_group>

        <effect_group name="LBD Decay Activity Resets for Crafting Armor">
            <triggered_effect trigger="onSelfItemCrafted" action="ModifyCVar"
                              cvar="$craftingarmor_decay_counter" operation="set" value="0">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingArmor"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfScrapItem" action="ModifyCVar"
                              cvar="$craftingarmor_decay_counter" operation="set" value="0">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingArmor"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfItemRepaired" action="ModifyCVar"
                              cvar="$craftingarmor_decay_counter" operation="set" value="0">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingArmor"/>
                <requirement name="ItemPercentDamaged, SCore" operation="GTE" value="0.5"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfItemRepaired" action="ModifyCVar" cvar="$craftingarmor_decay_counter" operation="set" value="0">
                <requirement name="ProgressionLevel" progression_name="craftingArmor" operation="LTE" value="10"/>
                <requirement name="ItemHasProperty, SCore" property="ArmorGroup" prop_value="groupPrimitive"/>
            </triggered_effect>
        </effect_group>
    </append>

    <!--
        LEARNING BY USING. The full rationale is in HarvestingTools.xml; the short version
        is that making, mending and scrapping are rare events, so a skill fed only by them
        sits still.

        YOU LEARN ARMOUR BY BEING HIT IN IT. onOtherDamagedSelf is the damage received
        trigger the Light, Medium and Heavy Armor perks already use, and it is the honest
        reading of "using" armour - wearing it while nothing happens teaches nothing.

        Deliberately NOT the onSelfRun / onSelfWalk pair those perks also carry. Walking
        is continuous, so at one XP every fifteen seconds a player would level armour
        crafting by strolling around the base, which is the passive grind this whole
        system exists to avoid.

        WornItems counts equipped slots whose item carries any of the listed tags and
        compares that count - HasAnyTags, so the list is an OR - which is why one
        requirement covers all three armour classes. value="1" because this skill builds
        every class, so any armour on your body counts. The five items it unlocks are
        armorPrimitiveMaster and friends, template items with no tags of their own, so
        the worn pieces are what has to be tested.

        1 XP behind a 15 second lockout, the same rate every other use path in this folder
        runs at, read from the shared $lbd_xp_crafting_use_base.
    -->
    <append xpath="/buffs/buff[@name='buffLBD_GeneralManager']">
        <effect_group name="LBD Crafting Skill - Armor (Use)">
            <requirement name="WornItems" tags="lightArmor,mediumArmor,heavyArmor" operation="GTE" value="1"/>

            <triggered_effect trigger="onOtherDamagedSelf" action="LogMessageCVars, SCore"
                              message="LBD DEBUG: Crafting Armor - Attempting 'Use' XP (+@$lbd_xp_crafting_use_base)">
                <requirement name="NotHasBuff" buff="buffLBD_craftingArmor_UseCoolDown"/>
                <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
            </triggered_effect>
            <triggered_effect trigger="onOtherDamagedSelf" action="ModifyCVar"
                              cvar="$craftingarmor_lbd_xp" operation="add" value="@$lbd_xp_crafting_use_base">
                <requirement name="NotHasBuff" buff="buffLBD_craftingArmor_UseCoolDown"/>
            </triggered_effect>
            <triggered_effect trigger="onOtherDamagedSelf" action="AddBuff"
                              buff="buffLBD_craftingArmor_UseCoolDown">
                <requirement name="NotHasBuff" buff="buffLBD_craftingArmor_UseCoolDown"/>
            </triggered_effect>

            <triggered_effect trigger="onOtherDamagedSelf" action="AddBuff"
                              buff="buffLBD_craftingArmor_LevelUpCheck">
                <requirement name="CVarCompare" cvar="$craftingarmor_lbd_xp" operation="GTE"
                             value="@$craftingarmor_lbd_xptonext"/>
            </triggered_effect>

        </effect_group>
    </append>


    <append xpath="/buffs">
        <buff name="buffLBD_craftingArmor_LevelUpCheck" hidden="true">
            <stack_type value="ignore"/><duration value="1"/>
            <!-- One ungated group, matching the 19 crafting skills that have no attribute
                 requirement at all.

                 This used to be split in two, with levels 5 and up gated on
                 attGeneral GTE 2. No such progression exists - the vanilla General tree is
                 attGeneralPerks, a hidden container with max_level 0 - so the requirement
                 read 0 and never passed, hard capping the skill at level 5. Its only real
                 counterpart cannot be levelled either, so the gate is dropped rather than
                 repointed. The split, and the ordering note that went with it, existed only
                 to keep the gated and ungated branches from both firing on a 4 -> 5 step;
                 with a single group there is nothing to double up. -->
            <effect_group>
                <requirement name="CanPurchasePerk, SCore" progression_name="craftingArmor" />
                <triggered_effect trigger="onSelfBuffStart" action="LogMessageCVars, SCore" message="LBD DEBUG: Armor - Level Up SUCCESS (craftingArmor)">
                    <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
                </triggered_effect>
                <triggered_effect trigger="onSelfBuffStart" action="AddProgressionLevel" progression_name="craftingArmor" level="1"/>
                <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$craftingarmor_lbd_xp" operation="subtract" value="@$craftingarmor_lbd_xptonext"/>
                <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$craftingarmor_lbd_xptonext" operation="multiply" value="@$lbd_xp_crafting_curve_multiplier"/>
                <triggered_effect trigger="onSelfBuffStart" action="ShowPerkLevelUp, SCore" perk="craftingArmor" sound="read_skillbook_final" />
            </effect_group>
            <effect_group>
                <requirement name="CVarCompare" cvar="$craftingarmor_lbd_xp" operation="GTE" value="@$craftingarmor_lbd_xptonext"/>
                <requirement name="!CanPurchasePerk, SCore" progression_name="craftingArmor" />
                <triggered_effect trigger="onSelfBuffStart" action="LogMessageCVars, SCore" message="LBD DEBUG: Armor - Level Up FAILED. Perk is locked by requirements.">
                    <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
                </triggered_effect>
            </effect_group>
        </buff>
        <buff name="buffLBD_craftingArmor_ActionCoolDown" hidden="true"><duration value="1"/></buff>
        <!-- Throttles learning by use. Separate from ActionCoolDown, which exists to stop a
             single craft double-scoring and only needs a second. -->
        <buff name="buffLBD_craftingArmor_UseCoolDown" hidden="true"><duration value="15"/></buff>

        <buff name="buffLBD_craftingArmor_T0RepairCoolDown" hidden="true"><duration value="5"/></buff>

    </append>
</configs>