<configs>
    <append xpath="/buffs/buff[@name='buffLBD_PerceptionManager']">
        <effect_group name="LBD Crafting Skill - Rifles">
            <triggered_effect trigger="onSelfItemCrafted" action="LogMessageCVars, SCore" message="LBD DEBUG: Crafting Rifles - Attempting 'Craft' XP (+@$lbd_xp_crafting_base)">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingRifles"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingRifles_ActionCoolDown"/>
                <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
                <requirement name="!RequirementCraftedItemMatchesCVar, SCore" cvar="$craftingrifles_lbd_lastitem"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfItemCrafted" action="ModifyCVar" cvar="$craftingrifles_lbd_xp" operation="add" value="@$lbd_xp_crafting_base">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingRifles"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingRifles_ActionCoolDown"/>
                <requirement name="!RequirementCraftedItemMatchesCVar, SCore" cvar="$craftingrifles_lbd_lastitem"/>
            </triggered_effect>

            <triggered_effect trigger="onSelfScrapItem" action="LogMessageCVars, SCore" message="LBD DEBUG: Crafting Rifles - Attempting 'Scrap' XP (+@$lbd_xp_scrapping_base)">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingRifles"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingRifles_ActionCoolDown"/>
                <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfScrapItem" action="ModifyCVar" cvar="$craftingrifles_lbd_xp" operation="add" value="@$lbd_xp_scrapping_base">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingRifles"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingRifles_ActionCoolDown"/>
            </triggered_effect>

            <triggered_effect trigger="onSelfItemRepaired" action="LogMessageCVars, SCore" message="LBD DEBUG: Crafting Rifles - Attempting 'Repair' XP (+@$lbd_xp_repairing_base)">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingRifles"/>
                <requirement name="ItemPercentDamaged, SCore" operation="GTE" value="0.5"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingRifles_ActionCoolDown"/>
                <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfItemRepaired" action="ModifyCVar" cvar="$craftingrifles_lbd_xp" operation="add" value="@$lbd_xp_repairing_base">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingRifles"/>
                <requirement name="ItemPercentDamaged, SCore" operation="GTE" value="0.5"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingRifles_ActionCoolDown"/>
            </triggered_effect>

            <triggered_effect trigger="onSelfItemCrafted" action="LogMessageCVars, SCore" message="LBD DEBUG: Crafting Rifles - Applying Cooldown (Craft)">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingRifles"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingRifles_ActionCoolDown"/>
                <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfItemCrafted" action="AddBuff" buff="buffLBD_craftingRifles_ActionCoolDown">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingRifles"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingRifles_ActionCoolDown"/>
            </triggered_effect>

            <triggered_effect trigger="onSelfScrapItem" action="LogMessageCVars, SCore" message="LBD DEBUG: Crafting Rifles - Applying Cooldown (Scrap)">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingRifles"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingRifles_ActionCoolDown"/>
                <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfScrapItem" action="AddBuff" buff="buffLBD_craftingRifles_ActionCoolDown">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingRifles"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingRifles_ActionCoolDown"/>
            </triggered_effect>

            <triggered_effect trigger="onSelfItemRepaired" action="LogMessageCVars, SCore" message="LBD DEBUG: Crafting Rifles - Applying Cooldown (Repair)">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingRifles"/>
                <requirement name="ItemPercentDamaged, SCore" operation="GTE" value="0.5"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingRifles_ActionCoolDown"/>
                <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfItemRepaired" action="AddBuff" buff="buffLBD_craftingRifles_ActionCoolDown">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingRifles"/>
                <requirement name="ItemPercentDamaged, SCore" operation="GTE" value="0.5"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingRifles_ActionCoolDown"/>
            </triggered_effect>

            <triggered_effect trigger="onSelfItemCrafted" action="LogMessageCVars, SCore" message="LBD DEBUG: Crafting Rifles - Triggering Level Up Check (Craft)">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingRifles"/>
                <requirement name="CVarCompare" cvar="$craftingrifles_lbd_xp" operation="GTE" value="@$craftingrifles_lbd_xptonext"/>
                <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfItemCrafted" action="AddBuff" buff="buffLBD_craftingRifles_LevelUpCheck">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingRifles"/>
                <requirement name="CVarCompare" cvar="$craftingrifles_lbd_xp" operation="GTE" value="@$craftingrifles_lbd_xptonext"/>
            </triggered_effect>

            <triggered_effect trigger="onSelfScrapItem" action="LogMessageCVars, SCore" message="LBD DEBUG: Crafting Rifles - Triggering Level Up Check (Scrap)">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingRifles"/>
                <requirement name="CVarCompare" cvar="$craftingrifles_lbd_xp" operation="GTE" value="@$craftingrifles_lbd_xptonext"/>
                <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfScrapItem" action="AddBuff" buff="buffLBD_craftingRifles_LevelUpCheck">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingRifles"/>
                <requirement name="CVarCompare" cvar="$craftingrifles_lbd_xp" operation="GTE" value="@$craftingrifles_lbd_xptonext"/>
            </triggered_effect>

            <triggered_effect trigger="onSelfItemRepaired" action="LogMessageCVars, SCore" message="LBD DEBUG: Crafting Rifles - Triggering Level Up Check (Repair)">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingRifles"/>
                <requirement name="ItemPercentDamaged, SCore" operation="GTE" value="0.5"/>
                <requirement name="CVarCompare" cvar="$craftingrifles_lbd_xp" operation="GTE" value="@$craftingrifles_lbd_xptonext"/>
                <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfItemRepaired" action="AddBuff" buff="buffLBD_craftingRifles_LevelUpCheck">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingRifles"/>
                <requirement name="ItemPercentDamaged, SCore" operation="GTE" value="0.5"/>
                <requirement name="CVarCompare" cvar="$craftingrifles_lbd_xp" operation="GTE" value="@$craftingrifles_lbd_xptonext"/>
            </triggered_effect>

            <!-- T0 starter gear. These items carry no UnlockedBy property, so the paths
                 above cannot see them, and below level 11 there is nothing else craftable -
                 vanilla unlocks the T1 recipes for this skill at 11. Pays until then and
                 stops, letting the UnlockedBy paths take over. Scrap is deliberately not
                 included: craft-then-scrap would loop for double XP. -->
            <triggered_effect trigger="onSelfItemCrafted" action="LogMessageCVars, SCore" message="LBD DEBUG: Crafting Rifles - Attempting T0 Craft XP (+@$lbd_xp_crafting_base)">
                <requirement name="ProgressionLevel" progression_name="craftingRifles" operation="LTE" value="10"/>
                <requirement name="ItemHasTags" tags="T0"/>
                <requirement name="ItemHasTags" tags="rifleSkill"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingRifles_T0RepairCoolDown"/>
                <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
                <requirement name="!RequirementCraftedItemMatchesCVar, SCore" cvar="$craftingrifles_lbd_lastitem"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfItemCrafted" action="ModifyCVar" cvar="$craftingrifles_lbd_xp" operation="add" value="@$lbd_xp_crafting_base">
                <requirement name="ProgressionLevel" progression_name="craftingRifles" operation="LTE" value="10"/>
                <requirement name="ItemHasTags" tags="T0"/>
                <requirement name="ItemHasTags" tags="rifleSkill"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingRifles_T0RepairCoolDown"/>
                <requirement name="!RequirementCraftedItemMatchesCVar, SCore" cvar="$craftingrifles_lbd_lastitem"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfItemRepaired" action="LogMessageCVars, SCore" message="LBD DEBUG: Crafting Rifles - Attempting T0 Repair XP (+@$lbd_xp_repairing_base)">
                <requirement name="ProgressionLevel" progression_name="craftingRifles" operation="LTE" value="10"/>
                <requirement name="ItemHasTags" tags="T0"/>
                <requirement name="ItemHasTags" tags="rifleSkill"/>
                <requirement name="ItemPercentDamaged, SCore" operation="GTE" value="0.5"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingRifles_T0RepairCoolDown"/>
                <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfItemRepaired" action="ModifyCVar" cvar="$craftingrifles_lbd_xp" operation="add" value="@$lbd_xp_repairing_base">
                <requirement name="ProgressionLevel" progression_name="craftingRifles" operation="LTE" value="10"/>
                <requirement name="ItemHasTags" tags="T0"/>
                <requirement name="ItemHasTags" tags="rifleSkill"/>
                <requirement name="ItemPercentDamaged, SCore" operation="GTE" value="0.5"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingRifles_T0RepairCoolDown"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfItemCrafted" action="AddBuff" buff="buffLBD_craftingRifles_T0RepairCoolDown">
                <requirement name="ProgressionLevel" progression_name="craftingRifles" operation="LTE" value="10"/>
                <requirement name="ItemHasTags" tags="T0"/>
                <requirement name="ItemHasTags" tags="rifleSkill"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingRifles_T0RepairCoolDown"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfItemRepaired" action="AddBuff" buff="buffLBD_craftingRifles_T0RepairCoolDown">
                <requirement name="ProgressionLevel" progression_name="craftingRifles" operation="LTE" value="10"/>
                <requirement name="ItemHasTags" tags="T0"/>
                <requirement name="ItemHasTags" tags="rifleSkill"/>
                <requirement name="ItemPercentDamaged, SCore" operation="GTE" value="0.5"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingRifles_T0RepairCoolDown"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfItemCrafted" action="LogMessageCVars, SCore" message="LBD DEBUG: Crafting Rifles - Triggering Level Up Check (T0 Craft)">
                <requirement name="ProgressionLevel" progression_name="craftingRifles" operation="LTE" value="10"/>
                <requirement name="ItemHasTags" tags="T0"/>
                <requirement name="ItemHasTags" tags="rifleSkill"/>
                <requirement name="CVarCompare" cvar="$craftingrifles_lbd_xp" operation="GTE" value="@$craftingrifles_lbd_xptonext"/>
                <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfItemCrafted" action="AddBuff" buff="buffLBD_craftingRifles_LevelUpCheck">
                <requirement name="ProgressionLevel" progression_name="craftingRifles" operation="LTE" value="10"/>
                <requirement name="ItemHasTags" tags="T0"/>
                <requirement name="ItemHasTags" tags="rifleSkill"/>
                <requirement name="CVarCompare" cvar="$craftingrifles_lbd_xp" operation="GTE" value="@$craftingrifles_lbd_xptonext"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfItemRepaired" action="AddBuff" buff="buffLBD_craftingRifles_LevelUpCheck">
                <requirement name="ProgressionLevel" progression_name="craftingRifles" operation="LTE" value="10"/>
                <requirement name="ItemHasTags" tags="T0"/>
                <requirement name="ItemHasTags" tags="rifleSkill"/>
                <requirement name="ItemPercentDamaged, SCore" operation="GTE" value="0.5"/>
                <requirement name="CVarCompare" cvar="$craftingrifles_lbd_xp" operation="GTE" value="@$craftingrifles_lbd_xptonext"/>
            </triggered_effect>

            <!-- Remember what was just crafted. Ordered last so the awards above
                 compare against the PREVIOUS craft, not this one. A queue of twenty
                 identical items now scores once; twenty different items score twenty
                 times. A cooldown cannot make that distinction - when an item takes
                 longer to craft than the cooldown lasts, every craft in the queue
                 scores regardless. -->
            <triggered_effect trigger="onSelfItemCrafted" action="SetCVarFromItemType, SCore" cvar="$craftingrifles_lbd_lastitem"/>

        </effect_group>

     
    </append>

    <!--
        LEARNING BY USING. Pays for fighting with a rifle, not just for building one.
        The full rationale is in HarvestingTools.xml; the short version is that making,
        mending and scrapping are rare events, so a skill fed only by them sits still.

        onSelfDamagedOther rather than a ray hit, deliberately. The matching perk trains
        on any swing that connects, including one into a wall; a crafting skill should
        not, or a player could grind it on a doorframe. Damaging something is the
        unambiguous "this weapon was used" signal, and it is the trigger Archery already
        uses.

        rifleSkill is the vanilla tag shared by every item this skill unlocks and by nothing
        else. 1 XP behind a 15 second lockout, the same rate every other use path in this
        folder runs at, read from the shared $lbd_xp_crafting_use_base.
    -->
    <append xpath="/buffs/buff[@name='buffLBD_PerceptionManager']">
        <effect_group name="LBD Crafting Skill - Rifles (Use)">

            <requirement name="HoldingItemHasTags" tags="rifleSkill"/>

            <triggered_effect trigger="onSelfDamagedOther" action="LogMessageCVars, SCore"
                              message="LBD DEBUG: Rifles - Attempting 'Use' XP (+@$lbd_xp_crafting_use_base)">
                <requirement name="NotHasBuff" buff="buffLBD_craftingRifles_UseCoolDown"/>
                <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfDamagedOther" action="ModifyCVar"
                              cvar="$craftingrifles_lbd_xp" operation="add" value="@$lbd_xp_crafting_use_base">
                <requirement name="NotHasBuff" buff="buffLBD_craftingRifles_UseCoolDown"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfDamagedOther" action="AddBuff"
                              buff="buffLBD_craftingRifles_UseCoolDown">
                <requirement name="NotHasBuff" buff="buffLBD_craftingRifles_UseCoolDown"/>
            </triggered_effect>

            <triggered_effect trigger="onSelfDamagedOther" action="AddBuff"
                              buff="buffLBD_craftingRifles_LevelUpCheck">
                <requirement name="CVarCompare" cvar="$craftingrifles_lbd_xp" operation="GTE"
                             value="@$craftingrifles_lbd_xptonext"/>
            </triggered_effect>

        </effect_group>
    </append>


    <append xpath="/buffs">
        <buff name="buffLBD_craftingRifles_LevelUpCheck" hidden="true">
            <stack_type value="ignore"/><duration value="1"/>
            <effect_group>
                <requirement name="CanPurchasePerk, SCore" progression_name="craftingRifles" />
                <triggered_effect trigger="onSelfBuffStart" action="LogMessageCVars, SCore" message="LBD DEBUG: Rifles - Level Up SUCCESS (craftingRifles)">
                    <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
                </triggered_effect>
                <triggered_effect trigger="onSelfBuffStart" action="AddProgressionLevel" progression_name="craftingRifles" level="1"/>
                <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$craftingrifles_lbd_xp" operation="subtract" value="@$craftingrifles_lbd_xptonext"/>
                <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$craftingrifles_lbd_xptonext" operation="multiply" value="@$lbd_xp_crafting_curve_multiplier"/>
                <triggered_effect trigger="onSelfBuffStart" action="ShowPerkLevelUp, SCore" perk="craftingRifles" sound="read_skillbook_final" />
            </effect_group>
            <effect_group>
                <requirement name="!CanPurchasePerk, SCore" progression_name="craftingRifles" />
                <triggered_effect trigger="onSelfBuffStart" action="LogMessageCVars, SCore" message="LBD DEBUG: Rifles - Level Up FAILED. Perk is locked by requirements.">
                    <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
                </triggered_effect>
            </effect_group>
        </buff>

        <buff name="buffLBD_craftingRifles_ActionCoolDown" hidden="true"><duration value="1"/></buff>
        <!-- Throttles learning by use. Separate from ActionCoolDown, which exists to stop a
             single craft double-scoring and only needs a second. -->
        <buff name="buffLBD_craftingRifles_UseCoolDown" hidden="true"><duration value="15"/></buff>

    </append>
    <append xpath="/buffs">
        <!-- Shared throttle for the T0 craft and repair paths. -->
        <buff name="buffLBD_craftingRifles_T0RepairCoolDown" hidden="true"><duration value="5"/></buff>
    </append>
</configs>