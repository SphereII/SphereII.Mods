<configs>
    <append xpath="/buffs/buff[@name='buffLBD_PerceptionManager']">
        <effect_group name="LBD Crafting Skill - Explosives">
            <triggered_effect trigger="onSelfItemCrafted" action="LogMessageCVars, SCore" message="LBD DEBUG: Crafting Explosives - Attempting 'Craft' XP (+@$lbd_xp_crafting_base)">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingExplosives"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingExplosives_ActionCoolDown"/>
                <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
                <requirement name="!RequirementCraftedItemMatchesCVar, SCore" cvar="$craftingexplosives_lbd_lastitem"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfItemCrafted" action="ModifyCVar" cvar="$craftingexplosives_lbd_xp" operation="add" value="@$lbd_xp_crafting_base">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingExplosives"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingExplosives_ActionCoolDown"/>
                <requirement name="!RequirementCraftedItemMatchesCVar, SCore" cvar="$craftingexplosives_lbd_lastitem"/>
            </triggered_effect>

            <triggered_effect trigger="onSelfScrapItem" action="LogMessageCVars, SCore" message="LBD DEBUG: Crafting Explosives - Attempting 'Scrap' XP (+@$lbd_xp_scrapping_base)">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingExplosives"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingExplosives_ActionCoolDown"/>
                <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfScrapItem" action="ModifyCVar" cvar="$craftingexplosives_lbd_xp" operation="add" value="@$lbd_xp_scrapping_base">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingExplosives"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingExplosives_ActionCoolDown"/>
            </triggered_effect>

            <triggered_effect trigger="onSelfItemRepaired" action="LogMessageCVars, SCore" message="LBD DEBUG: Crafting Explosives - Attempting 'Repair' XP (+@$lbd_xp_repairing_base)">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingExplosives"/>
                <requirement name="ItemPercentDamaged, SCore" operation="GTE" value="0.5"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingExplosives_ActionCoolDown"/>
                <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfItemRepaired" action="ModifyCVar" cvar="$craftingexplosives_lbd_xp" operation="add" value="@$lbd_xp_repairing_base">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingExplosives"/>
                <requirement name="ItemPercentDamaged, SCore" operation="GTE" value="0.5"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingExplosives_ActionCoolDown"/>
            </triggered_effect>

            <triggered_effect trigger="onSelfItemCrafted" action="LogMessageCVars, SCore" message="LBD DEBUG: Crafting Explosives - Applying Cooldown (Craft)">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingExplosives"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingExplosives_ActionCoolDown"/>
                <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfItemCrafted" action="AddBuff" buff="buffLBD_craftingExplosives_ActionCoolDown">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingExplosives"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingExplosives_ActionCoolDown"/>
            </triggered_effect>

            <triggered_effect trigger="onSelfScrapItem" action="LogMessageCVars, SCore" message="LBD DEBUG: Crafting Explosives - Applying Cooldown (Scrap)">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingExplosives"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingExplosives_ActionCoolDown"/>
                <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfScrapItem" action="AddBuff" buff="buffLBD_craftingExplosives_ActionCoolDown">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingExplosives"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingExplosives_ActionCoolDown"/>
            </triggered_effect>

            <triggered_effect trigger="onSelfItemRepaired" action="LogMessageCVars, SCore" message="LBD DEBUG: Crafting Explosives - Applying Cooldown (Repair)">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingExplosives"/>
                <requirement name="ItemPercentDamaged, SCore" operation="GTE" value="0.5"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingExplosives_ActionCoolDown"/>
                <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfItemRepaired" action="AddBuff" buff="buffLBD_craftingExplosives_ActionCoolDown">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingExplosives"/>
                <requirement name="ItemPercentDamaged, SCore" operation="GTE" value="0.5"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingExplosives_ActionCoolDown"/>
            </triggered_effect>

            <triggered_effect trigger="onSelfItemCrafted" action="LogMessageCVars, SCore" message="LBD DEBUG: Crafting Explosives - Triggering Level Up Check (Craft)">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingExplosives"/>
                <requirement name="CVarCompare" cvar="$craftingexplosives_lbd_xp" operation="GTE" value="@$craftingexplosives_lbd_xptonext"/>
                <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfItemCrafted" action="AddBuff" buff="buffLBD_craftingExplosives_LevelUpCheck">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingExplosives"/>
                <requirement name="CVarCompare" cvar="$craftingexplosives_lbd_xp" operation="GTE" value="@$craftingexplosives_lbd_xptonext"/>
            </triggered_effect>

            <triggered_effect trigger="onSelfScrapItem" action="LogMessageCVars, SCore" message="LBD DEBUG: Crafting Explosives - Triggering Level Up Check (Scrap)">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingExplosives"/>
                <requirement name="CVarCompare" cvar="$craftingexplosives_lbd_xp" operation="GTE" value="@$craftingexplosives_lbd_xptonext"/>
                <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfScrapItem" action="AddBuff" buff="buffLBD_craftingExplosives_LevelUpCheck">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingExplosives"/>
                <requirement name="CVarCompare" cvar="$craftingexplosives_lbd_xp" operation="GTE" value="@$craftingexplosives_lbd_xptonext"/>
            </triggered_effect>

            <triggered_effect trigger="onSelfItemRepaired" action="LogMessageCVars, SCore" message="LBD DEBUG: Crafting Explosives - Triggering Level Up Check (Repair)">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingExplosives"/>
                <requirement name="ItemPercentDamaged, SCore" operation="GTE" value="0.5"/>
                <requirement name="CVarCompare" cvar="$craftingexplosives_lbd_xp" operation="GTE" value="@$craftingexplosives_lbd_xptonext"/>
                <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfItemRepaired" action="AddBuff" buff="buffLBD_craftingExplosives_LevelUpCheck">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingExplosives"/>
                <requirement name="ItemPercentDamaged, SCore" operation="GTE" value="0.5"/>
                <requirement name="CVarCompare" cvar="$craftingexplosives_lbd_xp" operation="GTE" value="@$craftingexplosives_lbd_xptonext"/>
            </triggered_effect>
            <!--
                =====================================================================
                THE MINES, WHICH EVERY PATH ABOVE IS BLIND TO
                =====================================================================

                Three of the fourteen recipes craftingExplosives unlocks produce BLOCKS
                rather than items - mineCookingPot at level 10, mineHubcap at 20 and
                mineAirFilter at 25. Blocks have no entry in items.xml, so they carry no
                UnlockedBy property, so every ItemHasProperty gate above matches nothing
                when one is crafted. A fifth of this skill's own recipe list trained it
                for exactly zero XP.

                This is the same defect already found and fixed in CraftingTraps.xml,
                where it was fatal because EVERY traps recipe is a block. Here it is
                merely silent: the launcher, the thrown charges, the rocket parts and the
                gunpowder are all real items and kept the skill moving, which is why it
                went unnoticed.

                RequirementCraftedBlockHasTags resolves the crafted item back to its block
                and tests that block's tags, which is the only way to ask this question.

                WHY tags="Mine" AND NOT THE THREE TIER TAGS. Every mine carries the generic
                "Mine" alongside its Mine1..Mine4 tier tag, so one term covers all of them
                and cannot go stale when a tier is added. It also picks up mineCandyTin,
                which is deliberate: the candy tin is the one mine with no unlock gate at
                all - no learnable tag, no craft_area - so it is craftable from level 0 and
                is how a player first meets this recipe family. Leaving it out would have
                meant the entry-level mine trained nothing while its three older siblings
                did. mineCandyTinTwitch comes along too, harmlessly.

                The decoy hubcapNoMine carries no Mine tag and is correctly excluded.

                NO SALVAGE PATH, unlike Traps. Traps needs one because its blocks are
                world furniture you strip with a wrench, and because its recipes are
                locked until level 25 so salvage is the only way in. Mines are neither:
                they are consumed when they detonate, and retrieving one is a BlockPickup
                granted by perkInfiltrator rather than a salvage swing, so there is no
                wrenching to reward and no bootstrap to solve.
            -->
            <triggered_effect trigger="onSelfItemCrafted" action="LogMessageCVars, SCore" message="LBD DEBUG: Crafting Explosives - Attempting Block Craft XP (+@$lbd_xp_crafting_base)">
                <requirement name="RequirementCraftedBlockHasTags, SCore" tags="Mine"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingExplosives_ActionCoolDown"/>
                <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
                <requirement name="!RequirementCraftedItemMatchesCVar, SCore" cvar="$craftingexplosives_lbd_lastitem"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfItemCrafted" action="ModifyCVar" cvar="$craftingexplosives_lbd_xp" operation="add" value="@$lbd_xp_crafting_base">
                <requirement name="RequirementCraftedBlockHasTags, SCore" tags="Mine"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingExplosives_ActionCoolDown"/>
                <requirement name="!RequirementCraftedItemMatchesCVar, SCore" cvar="$craftingexplosives_lbd_lastitem"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfItemCrafted" action="AddBuff" buff="buffLBD_craftingExplosives_ActionCoolDown">
                <requirement name="RequirementCraftedBlockHasTags, SCore" tags="Mine"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingExplosives_ActionCoolDown"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfItemCrafted" action="AddBuff" buff="buffLBD_craftingExplosives_LevelUpCheck">
                <requirement name="RequirementCraftedBlockHasTags, SCore" tags="Mine"/>
                <requirement name="CVarCompare" cvar="$craftingexplosives_lbd_xp" operation="GTE" value="@$craftingexplosives_lbd_xptonext"/>
            </triggered_effect>

            <triggered_effect trigger="onSelfScrapItem" action="LogMessageCVars, SCore" message="LBD DEBUG: Crafting Explosives - Attempting Block Scrap XP (+@$lbd_xp_scrapping_base)">
                <requirement name="RequirementCraftedBlockHasTags, SCore" tags="Mine"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingExplosives_ActionCoolDown"/>
                <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfScrapItem" action="ModifyCVar" cvar="$craftingexplosives_lbd_xp" operation="add" value="@$lbd_xp_scrapping_base">
                <requirement name="RequirementCraftedBlockHasTags, SCore" tags="Mine"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingExplosives_ActionCoolDown"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfScrapItem" action="AddBuff" buff="buffLBD_craftingExplosives_ActionCoolDown">
                <requirement name="RequirementCraftedBlockHasTags, SCore" tags="Mine"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingExplosives_ActionCoolDown"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfScrapItem" action="AddBuff" buff="buffLBD_craftingExplosives_LevelUpCheck">
                <requirement name="RequirementCraftedBlockHasTags, SCore" tags="Mine"/>
                <requirement name="CVarCompare" cvar="$craftingexplosives_lbd_xp" operation="GTE" value="@$craftingexplosives_lbd_xptonext"/>
            </triggered_effect>

            <!-- Remember what was just crafted. Ordered last so the awards above
                 compare against the PREVIOUS craft, not this one. A queue of twenty
                 identical items now scores once; twenty different items score twenty
                 times. A cooldown cannot make that distinction - when an item takes
                 longer to craft than the cooldown lasts, every craft in the queue
                 scores regardless. -->
            <triggered_effect trigger="onSelfItemCrafted" action="SetCVarFromItemType, SCore" cvar="$craftingexplosives_lbd_lastitem"/>

        </effect_group>

   
    </append>

    <!--
        LEARNING BY USING. The full rationale is in HarvestingTools.xml; the short version
        is that making, mending and scrapping are rare events, so a skill fed only by them
        sits still.

        NO HOLDING GATE, and that is the point. Every other use path in this folder asks
        what is in your hands, which cannot work here: by the time a pipe bomb hurts
        anything you have already thrown it, and you may be holding a second one, a
        weapon, or nothing at all. onSelfExplosionDamagedOther fires on the explosion
        rather than the throw, and attributes it to whoever caused it, so the item being
        gone by then does not matter.

        The trade is that it does not care WHICH explosion. A shot gas barrel or an
        exploding car trains this too. Demolitions Expert has behaved that way since it
        was written and nobody has minded; being near enough to set one off is arguably
        the same lesson.

        There is no ammo path to double up with either - the six usable items this skill
        unlocks are the launcher and the five thrown charges, and the loose rocket parts
        and gunpowder are components you never "use".

        1 XP behind a 15 second lockout, the same rate every other use path in this folder
        runs at, read from the shared $lbd_xp_crafting_use_base.
    -->
    <append xpath="/buffs/buff[@name='buffLBD_PerceptionManager']">
        <effect_group name="LBD Crafting Skill - Explosives (Use)">

            <triggered_effect trigger="onSelfExplosionDamagedOther" action="LogMessageCVars, SCore"
                              message="LBD DEBUG: Crafting Explosives - Attempting 'Use' XP (+@$lbd_xp_crafting_use_base)">
                <requirement name="NotHasBuff" buff="buffLBD_craftingExplosives_UseCoolDown"/>
                <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfExplosionDamagedOther" action="ModifyCVar"
                              cvar="$craftingexplosives_lbd_xp" operation="add" value="@$lbd_xp_crafting_use_base">
                <requirement name="NotHasBuff" buff="buffLBD_craftingExplosives_UseCoolDown"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfExplosionDamagedOther" action="AddBuff"
                              buff="buffLBD_craftingExplosives_UseCoolDown">
                <requirement name="NotHasBuff" buff="buffLBD_craftingExplosives_UseCoolDown"/>
            </triggered_effect>

            <triggered_effect trigger="onSelfExplosionDamagedOther" action="AddBuff"
                              buff="buffLBD_craftingExplosives_LevelUpCheck">
                <requirement name="CVarCompare" cvar="$craftingexplosives_lbd_xp" operation="GTE"
                             value="@$craftingexplosives_lbd_xptonext"/>
            </triggered_effect>

        </effect_group>
    </append>


    <append xpath="/buffs">
        <buff name="buffLBD_craftingExplosives_LevelUpCheck" hidden="true">
            <stack_type value="ignore"/><duration value="1"/>
            <effect_group>
                <requirement name="CanPurchasePerk, SCore" progression_name="craftingExplosives" />
                <triggered_effect trigger="onSelfBuffStart" action="LogMessageCVars, SCore" message="LBD DEBUG: Explosives - Level Up SUCCESS (craftingExplosives)">
                    <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
                </triggered_effect>
                <triggered_effect trigger="onSelfBuffStart" action="AddProgressionLevel" progression_name="craftingExplosives" level="1"/>
                <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$craftingexplosives_lbd_xp" operation="subtract" value="@$craftingexplosives_lbd_xptonext"/>
                <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$craftingexplosives_lbd_xptonext" operation="multiply" value="@$lbd_xp_crafting_curve_multiplier"/>
                <triggered_effect trigger="onSelfBuffStart" action="ShowPerkLevelUp, SCore" perk="craftingExplosives" sound="read_skillbook_final" />
            </effect_group>
            <effect_group>
                <requirement name="!CanPurchasePerk, SCore" progression_name="craftingExplosives" />
                <triggered_effect trigger="onSelfBuffStart" action="LogMessageCVars, SCore" message="LBD DEBUG: Explosives - Level Up FAILED. Perk is locked by requirements.">
                    <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
                </triggered_effect>
            </effect_group>
        </buff>

        <buff name="buffLBD_craftingExplosives_ActionCoolDown" hidden="true"><duration value="1"/></buff>
        <!-- Throttles learning by use. Separate from ActionCoolDown, which exists to stop a
             single craft double-scoring and only needs a second. -->
        <buff name="buffLBD_craftingExplosives_UseCoolDown" hidden="true"><duration value="15"/></buff>

    </append>
</configs>