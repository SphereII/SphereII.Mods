<configs>
    <append xpath="/buffs/buff[@name='buffLBD_GeneralManager']">
        <effect_group name="LBD Crafting Skill - Seeds">
            <triggered_effect trigger="onSelfCraftedRecipe" action="LogMessageCVars, SCore" message="LBD DEBUG: Crafting Seeds - Attempting 'Craft Small Seed' XP (+@$lbd_xp_crafting_seed_small_base)">
                <requirement name="RecipeHasIngredients, SCore" ingredients="plantedCotton1,plantedGoldenrod1,plantedCoffee1,plantedYucca1,plantedAloe1"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingSeeds_ActionCoolDown"/>
                <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
                <requirement name="!RequirementCraftedItemMatchesCVar, SCore" cvar="$craftingseeds_lbd_lastitem"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfCraftedRecipe" action="ModifyCVar" cvar="$craftingseeds_lbd_xp" operation="add" value="@$lbd_xp_crafting_seed_small_base">
                <requirement name="RecipeHasIngredients, SCore" ingredients="plantedCotton1,plantedGoldenrod1,plantedCoffee1,plantedYucca1,plantedAloe1"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingSeeds_ActionCoolDown"/>
                <requirement name="!RequirementCraftedItemMatchesCVar, SCore" cvar="$craftingseeds_lbd_lastitem"/>
            </triggered_effect>

            <triggered_effect trigger="onSelfCraftedRecipe" action="LogMessageCVars, SCore" message="LBD DEBUG: Crafting Seeds - Attempting 'Craft Large Seed' XP (+@$lbd_xp_crafting_seed_large_base)">
                <requirement name="RecipeHasIngredients, SCore" ingredients="plantedBlueberry1,plantedPumpkin1,plantedMushroom1,plantedCorn1,plantedPotato1"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingSeeds_ActionCoolDown"/>
                <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
                <requirement name="!RequirementCraftedItemMatchesCVar, SCore" cvar="$craftingseeds_lbd_lastitem"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfCraftedRecipe" action="ModifyCVar" cvar="$craftingseeds_lbd_xp" operation="add" value="@$lbd_xp_crafting_seed_large_base">
                <requirement name="RecipeHasIngredients, SCore" ingredients="plantedBlueberry1,plantedPumpkin1,plantedMushroom1,plantedCorn1,plantedPotato1"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingSeeds_ActionCoolDown"/>
                <requirement name="!RequirementCraftedItemMatchesCVar, SCore" cvar="$craftingseeds_lbd_lastitem"/>
            </triggered_effect>

            <triggered_effect trigger="onSelfCraftedRecipe" action="LogMessageCVars, SCore" message="LBD DEBUG: Crafting Seeds - Applying Cooldown (Craft)">
                <!-- Was wrapped in <requirement name="requirements" type="HiddenForDisplay"
                     match_all="true">. There is no requirement class called "requirements" -
                     the nested group element is the plural <requirements> - so the wrapper
                     resolved to nothing, passed, and took the RecipeHasIngredients check with
                     it. Every craft of anything applied the Seeds cooldown and spammed the
                     log. The wrapper held a single requirement, so it is simply inlined. -->
                <requirement name="RecipeHasIngredients, SCore" ingredients="plantedCotton1,plantedGoldenrod1,plantedCoffee1,plantedYucca1,plantedAloe1,plantedBlueberry1,plantedPumpkin1,plantedMushroom1,plantedCorn1,plantedPotato1"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingSeeds_ActionCoolDown"/>
                <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfCraftedRecipe" action="AddBuff" buff="buffLBD_craftingSeeds_ActionCoolDown">
                <!-- Was wrapped in <requirement name="requirements" type="HiddenForDisplay"
                     match_all="true">. There is no requirement class called "requirements" -
                     the nested group element is the plural <requirements> - so the wrapper
                     resolved to nothing, passed, and took the RecipeHasIngredients check with
                     it. Every craft of anything applied the Seeds cooldown and spammed the
                     log. The wrapper held a single requirement, so it is simply inlined. -->
                <requirement name="RecipeHasIngredients, SCore" ingredients="plantedCotton1,plantedGoldenrod1,plantedCoffee1,plantedYucca1,plantedAloe1,plantedBlueberry1,plantedPumpkin1,plantedMushroom1,plantedCorn1,plantedPotato1"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingSeeds_ActionCoolDown"/>
            </triggered_effect>

            <triggered_effect trigger="onSelfCraftedRecipe" action="LogMessageCVars, SCore" message="LBD DEBUG: Crafting Seeds - Triggering Level Up Check (Craft)">
                <!-- Was wrapped in <requirement name="requirements" type="HiddenForDisplay"
                     match_all="true">. There is no requirement class called "requirements" -
                     the nested group element is the plural <requirements> - so the wrapper
                     resolved to nothing, passed, and took the RecipeHasIngredients check with
                     it. Every craft of anything applied the Seeds cooldown and spammed the
                     log. The wrapper held a single requirement, so it is simply inlined. -->
                <requirement name="RecipeHasIngredients, SCore" ingredients="plantedCotton1,plantedGoldenrod1,plantedCoffee1,plantedYucca1,plantedAloe1,plantedBlueberry1,plantedPumpkin1,plantedMushroom1,plantedCorn1,plantedPotato1"/>
                <requirement name="CVarCompare" cvar="$craftingseeds_lbd_xp" operation="GTE" value="@$craftingseeds_lbd_xptonext"/>
                <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfCraftedRecipe" action="AddBuff" buff="buffLBD_craftingSeeds_LevelUpCheck">
                <!-- Was wrapped in <requirement name="requirements" type="HiddenForDisplay"
                     match_all="true">. There is no requirement class called "requirements" -
                     the nested group element is the plural <requirements> - so the wrapper
                     resolved to nothing, passed, and took the RecipeHasIngredients check with
                     it. Every craft of anything applied the Seeds cooldown and spammed the
                     log. The wrapper held a single requirement, so it is simply inlined. -->
                <requirement name="RecipeHasIngredients, SCore" ingredients="plantedCotton1,plantedGoldenrod1,plantedCoffee1,plantedYucca1,plantedAloe1,plantedBlueberry1,plantedPumpkin1,plantedMushroom1,plantedCorn1,plantedPotato1"/>
                <requirement name="CVarCompare" cvar="$craftingseeds_lbd_xp" operation="GTE" value="@$craftingseeds_lbd_xptonext"/>
            </triggered_effect>
            <!-- Remember what was just crafted. Ordered last so the awards above
                 compare against the PREVIOUS craft, not this one. -->
            <triggered_effect trigger="onSelfCraftedRecipe" action="SetCVarFromItemType, SCore" cvar="$craftingseeds_lbd_lastitem"/>

        </effect_group>

    
    </append>

    <append xpath="/buffs">
        <buff name="buffLBD_craftingSeeds_LevelUpCheck" hidden="true">
            <stack_type value="ignore"/><duration value="1"/>
            <effect_group>
                <requirement name="CanPurchasePerk, SCore" progression_name="craftingSeeds" />
                <triggered_effect trigger="onSelfBuffStart" action="LogMessageCVars, SCore" message="LBD DEBUG: Seeds - Level Up SUCCESS (craftingSeeds)">
                    <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
                </triggered_effect>
                <triggered_effect trigger="onSelfBuffStart" action="AddProgressionLevel" progression_name="craftingSeeds" level="1"/>
                <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$craftingseeds_lbd_xp" operation="subtract" value="@$craftingseeds_lbd_xptonext"/>
                <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$craftingseeds_lbd_xptonext" operation="multiply" value="@$lbd_xp_crafting_curve_multiplier"/>
                <triggered_effect trigger="onSelfBuffStart" action="ShowPerkLevelUp, SCore" perk="craftingSeeds" sound="read_skillbook_final" />
            </effect_group>
            <effect_group>
                <requirement name="!CanPurchasePerk, SCore" progression_name="craftingSeeds" />
                <triggered_effect trigger="onSelfBuffStart" action="LogMessageCVars, SCore" message="LBD DEBUG: Seeds - Level Up FAILED. Perk is locked by requirements.">
                    <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
                </triggered_effect>
            </effect_group>
        </buff>

        <buff name="buffLBD_craftingSeeds_ActionCoolDown" hidden="true"><duration value="1"/></buff>

    </append>
</configs>