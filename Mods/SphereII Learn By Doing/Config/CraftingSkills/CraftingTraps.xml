<configs>
    <append xpath="/buffs/buff[@name='buffLBD_IntellectManager']">
        <effect_group name="LBD Crafting Skill - Traps">
            <triggered_effect trigger="onSelfItemCrafted" action="LogMessageCVars, SCore" message="LBD DEBUG: Crafting Traps - Attempting 'Craft' XP (+@$lbd_xp_crafting_base)">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingTraps"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingTraps_ActionCoolDown"/>
                <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
                <requirement name="!RequirementCraftedItemMatchesCVar, SCore" cvar="$craftingtraps_lbd_lastitem"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfItemCrafted" action="ModifyCVar" cvar="$craftingtraps_lbd_xp" operation="add" value="@$lbd_xp_crafting_base">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingTraps"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingTraps_ActionCoolDown"/>
                <requirement name="!RequirementCraftedItemMatchesCVar, SCore" cvar="$craftingtraps_lbd_lastitem"/>
            </triggered_effect>

            <triggered_effect trigger="onSelfScrapItem" action="LogMessageCVars, SCore" message="LBD DEBUG: Crafting Traps - Attempting 'Scrap' XP (+@$lbd_xp_scrapping_base)">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingTraps"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingTraps_ActionCoolDown"/>
                <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfScrapItem" action="ModifyCVar" cvar="$craftingtraps_lbd_xp" operation="add" value="@$lbd_xp_scrapping_base">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingTraps"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingTraps_ActionCoolDown"/>
            </triggered_effect>

            <triggered_effect trigger="onSelfItemRepaired" action="LogMessageCVars, SCore" message="LBD DEBUG: Crafting Traps - Attempting 'Repair' XP (+@$lbd_xp_repairing_base)">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingTraps"/>
                <requirement name="ItemPercentDamaged, SCore" operation="GTE" value="0.5"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingTraps_ActionCoolDown"/>
                <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfItemRepaired" action="ModifyCVar" cvar="$craftingtraps_lbd_xp" operation="add" value="@$lbd_xp_repairing_base">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingTraps"/>
                <requirement name="ItemPercentDamaged, SCore" operation="GTE" value="0.5"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingTraps_ActionCoolDown"/>
            </triggered_effect>

            <triggered_effect trigger="onSelfItemCrafted" action="LogMessageCVars, SCore" message="LBD DEBUG: Crafting Traps - Applying Cooldown (Craft)">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingTraps"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingTraps_ActionCoolDown"/>
                <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfItemCrafted" action="LogMessageCVars, SCore" message="LBD DEBUG: Crafting Traps - Attempting Block Craft XP (+@$lbd_xp_crafting_base)">
                <requirement name="RequirementCraftedBlockHasTags, SCore" tags="trapsSkill"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingTraps_ActionCoolDown"/>
                <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
                <requirement name="!RequirementCraftedItemMatchesCVar, SCore" cvar="$craftingtraps_lbd_lastitem"/>
            </triggered_effect>

            <triggered_effect trigger="onSelfItemCrafted" action="AddBuff" buff="buffLBD_craftingTraps_ActionCoolDown">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingTraps"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingTraps_ActionCoolDown"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfScrapItem" action="LogMessageCVars, SCore" message="LBD DEBUG: Crafting Traps - Applying Cooldown (Scrap)">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingTraps"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingTraps_ActionCoolDown"/>
                <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
            </triggered_effect>

            <triggered_effect trigger="onSelfScrapItem" action="LogMessageCVars, SCore" message="LBD DEBUG: Crafting Traps - Attempting Block Scrap XP (+@$lbd_xp_scrapping_base)">
                <requirement name="RequirementCraftedBlockHasTags, SCore" tags="trapsSkill"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingTraps_ActionCoolDown"/>
                <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfScrapItem" action="AddBuff" buff="buffLBD_craftingTraps_ActionCoolDown">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingTraps"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingTraps_ActionCoolDown"/>
            </triggered_effect>

            <triggered_effect trigger="onSelfItemRepaired" action="LogMessageCVars, SCore" message="LBD DEBUG: Crafting Traps - Applying Cooldown (Repair)">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingTraps"/>
                <requirement name="ItemPercentDamaged, SCore" operation="GTE" value="0.5"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingTraps_ActionCoolDown"/>
                <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfItemRepaired" action="AddBuff" buff="buffLBD_craftingTraps_ActionCoolDown">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingTraps"/>
                <requirement name="ItemPercentDamaged, SCore" operation="GTE" value="0.5"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingTraps_ActionCoolDown"/>
            </triggered_effect>

            <triggered_effect trigger="onSelfItemCrafted" action="LogMessageCVars, SCore" message="LBD DEBUG: Crafting Traps - Triggering Level Up Check (Craft)">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingTraps"/>
                <requirement name="CVarCompare" cvar="$craftingtraps_lbd_xp" operation="GTE" value="@$craftingtraps_lbd_xptonext"/>
                <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfItemCrafted" action="AddBuff" buff="buffLBD_craftingTraps_LevelUpCheck">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingTraps"/>
                <requirement name="CVarCompare" cvar="$craftingtraps_lbd_xp" operation="GTE" value="@$craftingtraps_lbd_xptonext"/>
            </triggered_effect>

            <triggered_effect trigger="onSelfScrapItem" action="LogMessageCVars, SCore" message="LBD DEBUG: Crafting Traps - Triggering Level Up Check (Scrap)">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingTraps"/>
                <requirement name="CVarCompare" cvar="$craftingtraps_lbd_xp" operation="GTE" value="@$craftingtraps_lbd_xptonext"/>
                <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfScrapItem" action="AddBuff" buff="buffLBD_craftingTraps_LevelUpCheck">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingTraps"/>
                <requirement name="CVarCompare" cvar="$craftingtraps_lbd_xp" operation="GTE" value="@$craftingtraps_lbd_xptonext"/>
            </triggered_effect>

            <!-- Every craftingTraps recipe produces a block - dart trap, blade trap, turrets,
                 electric fence post. Blocks have no entry in items.xml and therefore no
                 UnlockedBy property, so the ItemHasProperty paths above match nothing at all -
                 this skill could not gain a single point. RequirementCraftedBlockHasTags
                 resolves the crafted item back to its block and tests the block's own tags.
                 Vanilla already tags every craftable block here, some directly and some
                 through the Extends chain, which BlocksFromXml inherits Tags along. -->
            <triggered_effect trigger="onSelfItemRepaired" action="LogMessageCVars, SCore" message="LBD DEBUG: Crafting Traps - Triggering Level Up Check (Repair)">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingTraps"/>
                <requirement name="ItemPercentDamaged, SCore" operation="GTE" value="0.5"/>
                <requirement name="CVarCompare" cvar="$craftingtraps_lbd_xp" operation="GTE" value="@$craftingtraps_lbd_xptonext"/>
                <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfItemRepaired" action="AddBuff" buff="buffLBD_craftingTraps_LevelUpCheck">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingTraps"/>
                <requirement name="ItemPercentDamaged, SCore" operation="GTE" value="0.5"/>
                <requirement name="CVarCompare" cvar="$craftingtraps_lbd_xp" operation="GTE" value="@$craftingtraps_lbd_xptonext"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfItemCrafted" action="ModifyCVar" cvar="$craftingtraps_lbd_xp" operation="add" value="@$lbd_xp_crafting_base">
                <requirement name="RequirementCraftedBlockHasTags, SCore" tags="trapsSkill"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingTraps_ActionCoolDown"/>
                <requirement name="!RequirementCraftedItemMatchesCVar, SCore" cvar="$craftingtraps_lbd_lastitem"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfScrapItem" action="ModifyCVar" cvar="$craftingtraps_lbd_xp" operation="add" value="@$lbd_xp_scrapping_base">
                <requirement name="RequirementCraftedBlockHasTags, SCore" tags="trapsSkill"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingTraps_ActionCoolDown"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfItemCrafted" action="AddBuff" buff="buffLBD_craftingTraps_ActionCoolDown">
                <requirement name="RequirementCraftedBlockHasTags, SCore" tags="trapsSkill"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingTraps_ActionCoolDown"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfScrapItem" action="AddBuff" buff="buffLBD_craftingTraps_ActionCoolDown">
                <requirement name="RequirementCraftedBlockHasTags, SCore" tags="trapsSkill"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingTraps_ActionCoolDown"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfItemCrafted" action="LogMessageCVars, SCore" message="LBD DEBUG: Crafting Traps - Triggering Level Up Check (Block Craft)">
                <requirement name="RequirementCraftedBlockHasTags, SCore" tags="trapsSkill"/>
                <requirement name="CVarCompare" cvar="$craftingtraps_lbd_xp" operation="GTE" value="@$craftingtraps_lbd_xptonext"/>
                <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfItemCrafted" action="AddBuff" buff="buffLBD_craftingTraps_LevelUpCheck">
                <requirement name="RequirementCraftedBlockHasTags, SCore" tags="trapsSkill"/>
                <requirement name="CVarCompare" cvar="$craftingtraps_lbd_xp" operation="GTE" value="@$craftingtraps_lbd_xptonext"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfScrapItem" action="AddBuff" buff="buffLBD_craftingTraps_LevelUpCheck">
                <requirement name="RequirementCraftedBlockHasTags, SCore" tags="trapsSkill"/>
                <requirement name="CVarCompare" cvar="$craftingtraps_lbd_xp" operation="GTE" value="@$craftingtraps_lbd_xptonext"/>
            </triggered_effect>


            <!-- Salvaging the blocks in the world, which is the only way into this skill.
                 Its recipes do not unlock until level 25 and nothing else it can craft is
                 ungated, so craft XP alone could never start it: crafting needed 25, 25
                 needed XP. Taking apart the dart traps, blade traps, fence posts and turrets
                 found in POIs works from level 0 and stops at 24, where the recipes open up
                 and the craft paths take over. Same shape craftingWorkstations already uses
                 for its own block-only problem: a wrench, a per-hit trickle and a payout on
                 the block coming down. -->
            <triggered_effect trigger="onSelfPrimaryActionRayHit" action="LogMessageCVars, SCore" message="LBD DEBUG: Crafting Traps - Attempting Salvage Hit XP (+@$lbd_xp_harvest_base)">
                <requirement name="ProgressionLevel" progression_name="craftingTraps" operation="LTE" value="24"/>
                <requirement name="HoldingItemHasTags" tags="perkSalvageOperations"/>
                <requirement name="RequirementIsTargetBlock, SCore" tags="trapsSkill"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingTraps_HitCoolDown"/>
                <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfPrimaryActionRayHit" action="ModifyCVar" cvar="$craftingtraps_lbd_xp" operation="add" value="@$lbd_xp_harvest_base">
                <requirement name="ProgressionLevel" progression_name="craftingTraps" operation="LTE" value="24"/>
                <requirement name="HoldingItemHasTags" tags="perkSalvageOperations"/>
                <requirement name="RequirementIsTargetBlock, SCore" tags="trapsSkill"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingTraps_HitCoolDown"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfPrimaryActionRayHit" action="AddBuff" buff="buffLBD_craftingTraps_HitCoolDown">
                <requirement name="ProgressionLevel" progression_name="craftingTraps" operation="LTE" value="24"/>
                <requirement name="HoldingItemHasTags" tags="perkSalvageOperations"/>
                <requirement name="RequirementIsTargetBlock, SCore" tags="trapsSkill"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingTraps_HitCoolDown"/>
            </triggered_effect>

            <triggered_effect trigger="onSelfDestroyedBlock" action="LogMessageCVars, SCore" message="LBD DEBUG: Crafting Traps - Attempting Salvage Teardown XP (+@$lbd_xp_crafting_bigxp)">
                <requirement name="ProgressionLevel" progression_name="craftingTraps" operation="LTE" value="24"/>
                <requirement name="HoldingItemHasTags" tags="perkSalvageOperations"/>
                <requirement name="RequirementIsTargetBlock, SCore" tags="trapsSkill"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingTraps_ActionCoolDown"/>
                <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfDestroyedBlock" action="ModifyCVar" cvar="$craftingtraps_lbd_xp" operation="add" value="@$lbd_xp_crafting_bigxp">
                <requirement name="ProgressionLevel" progression_name="craftingTraps" operation="LTE" value="24"/>
                <requirement name="HoldingItemHasTags" tags="perkSalvageOperations"/>
                <requirement name="RequirementIsTargetBlock, SCore" tags="trapsSkill"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingTraps_ActionCoolDown"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfDestroyedBlock" action="AddBuff" buff="buffLBD_craftingTraps_ActionCoolDown">
                <requirement name="ProgressionLevel" progression_name="craftingTraps" operation="LTE" value="24"/>
                <requirement name="HoldingItemHasTags" tags="perkSalvageOperations"/>
                <requirement name="RequirementIsTargetBlock, SCore" tags="trapsSkill"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingTraps_ActionCoolDown"/>
            </triggered_effect>

            <triggered_effect trigger="onSelfDestroyedBlock" action="LogMessageCVars, SCore" message="LBD DEBUG: Crafting Traps - Triggering Level Up Check (Salvage)">
                <requirement name="ProgressionLevel" progression_name="craftingTraps" operation="LTE" value="24"/>
                <requirement name="HoldingItemHasTags" tags="perkSalvageOperations"/>
                <requirement name="RequirementIsTargetBlock, SCore" tags="trapsSkill"/>
                <requirement name="CVarCompare" cvar="$craftingtraps_lbd_xp" operation="GTE" value="@$craftingtraps_lbd_xptonext"/>
                <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfDestroyedBlock" action="AddBuff" buff="buffLBD_craftingTraps_LevelUpCheck">
                <requirement name="ProgressionLevel" progression_name="craftingTraps" operation="LTE" value="24"/>
                <requirement name="HoldingItemHasTags" tags="perkSalvageOperations"/>
                <requirement name="RequirementIsTargetBlock, SCore" tags="trapsSkill"/>
                <requirement name="CVarCompare" cvar="$craftingtraps_lbd_xp" operation="GTE" value="@$craftingtraps_lbd_xptonext"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfPrimaryActionRayHit" action="AddBuff" buff="buffLBD_craftingTraps_LevelUpCheck">
                <requirement name="ProgressionLevel" progression_name="craftingTraps" operation="LTE" value="24"/>
                <requirement name="HoldingItemHasTags" tags="perkSalvageOperations"/>
                <requirement name="RequirementIsTargetBlock, SCore" tags="trapsSkill"/>
                <requirement name="CVarCompare" cvar="$craftingtraps_lbd_xp" operation="GTE" value="@$craftingtraps_lbd_xptonext"/>
            </triggered_effect>

            <!-- Remember what was just crafted. Ordered last so the awards above
                 compare against the PREVIOUS craft, not this one. A queue of twenty
                 identical items now scores once; twenty different items score twenty
                 times. A cooldown cannot make that distinction - when an item takes
                 longer to craft than the cooldown lasts, every craft in the queue
                 scores regardless. -->
            <triggered_effect trigger="onSelfItemCrafted" action="SetCVarFromItemType, SCore" cvar="$craftingtraps_lbd_lastitem"/>

        </effect_group>

    
    </append>

    <append xpath="/buffs">
        <buff name="buffLBD_craftingTraps_LevelUpCheck" hidden="true">
            <stack_type value="ignore"/><duration value="1"/>
            <effect_group>
                <requirement name="CanPurchasePerk, SCore" progression_name="craftingTraps" />
                <triggered_effect trigger="onSelfBuffStart" action="LogMessageCVars, SCore" message="LBD DEBUG: Traps - Level Up SUCCESS (craftingTraps)">
                    <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
                </triggered_effect>
                <triggered_effect trigger="onSelfBuffStart" action="AddProgressionLevel" progression_name="craftingTraps" level="1"/>
                <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$craftingtraps_lbd_xp" operation="subtract" value="@$craftingtraps_lbd_xptonext"/>
                <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$craftingtraps_lbd_xptonext" operation="multiply" value="@$lbd_xp_crafting_curve_multiplier"/>
                <triggered_effect trigger="onSelfBuffStart" action="ShowPerkLevelUp, SCore" perk="craftingTraps" sound="read_skillbook_final" />
            </effect_group>
            <effect_group>
                <requirement name="!CanPurchasePerk, SCore" progression_name="craftingTraps" />
                <triggered_effect trigger="onSelfBuffStart" action="LogMessageCVars, SCore" message="LBD DEBUG: Traps - Level Up FAILED. Perk is locked by requirements.">
                    <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
                </triggered_effect>
            </effect_group>
        </buff>

        <buff name="buffLBD_craftingTraps_ActionCoolDown" hidden="true"><duration value="1"/></buff>
        <!-- Per-hit throttle while salvaging, matching craftingWorkstations. -->
        <buff name="buffLBD_craftingTraps_HitCoolDown" hidden="true"><duration value="15"/></buff>

    
    </append>
</configs>