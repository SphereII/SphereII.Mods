<configs>
    <append xpath="/buffs/buff[@name='buffLBD_StrengthManager']">
        <effect_group name="LBD Crafting Skill - Sledgehammers">
            <triggered_effect trigger="onSelfItemCrafted" action="LogMessageCVars, SCore" message="LBD DEBUG: Crafting Sledgehammers - Attempting 'Craft' XP (+@$lbd_xp_crafting_base)">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingSledgehammers"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingSledgehammers_ActionCoolDown"/>
                <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
                <requirement name="!RequirementCraftedItemMatchesCVar, SCore" cvar="$craftingsledgehammers_lbd_lastitem"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfItemCrafted" action="ModifyCVar" cvar="$craftingsledgehammers_lbd_xp" operation="add" value="@$lbd_xp_crafting_base">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingSledgehammers"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingSledgehammers_ActionCoolDown"/>
                <requirement name="!RequirementCraftedItemMatchesCVar, SCore" cvar="$craftingsledgehammers_lbd_lastitem"/>
            </triggered_effect>

            <triggered_effect trigger="onSelfScrapItem" action="LogMessageCVars, SCore" message="LBD DEBUG: Crafting Sledgehammers - Attempting 'Scrap' XP (+@$lbd_xp_scrapping_base)">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingSledgehammers"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingSledgehammers_ActionCoolDown"/>
                <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfScrapItem" action="ModifyCVar" cvar="$craftingsledgehammers_lbd_xp" operation="add" value="@$lbd_xp_scrapping_base">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingSledgehammers"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingSledgehammers_ActionCoolDown"/>
            </triggered_effect>

            <triggered_effect trigger="onSelfItemRepaired" action="LogMessageCVars, SCore" message="LBD DEBUG: Crafting Sledgehammers - Attempting 'Repair' XP (+@$lbd_xp_repairing_base)">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingSledgehammers"/>
                <requirement name="ItemPercentDamaged, SCore" operation="GTE" value="0.5"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingSledgehammers_ActionCoolDown"/>
                <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfItemRepaired" action="ModifyCVar" cvar="$craftingsledgehammers_lbd_xp" operation="add" value="@$lbd_xp_repairing_base">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingSledgehammers"/>
                <requirement name="ItemPercentDamaged, SCore" operation="GTE" value="0.5"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingSledgehammers_ActionCoolDown"/>
            </triggered_effect>

            <triggered_effect trigger="onSelfItemCrafted" action="LogMessageCVars, SCore" message="LBD DEBUG: Crafting Sledgehammers - Applying Cooldown (Craft)">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingSledgehammers"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingSledgehammers_ActionCoolDown"/>
                <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfItemCrafted" action="AddBuff" buff="buffLBD_craftingSledgehammers_ActionCoolDown">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingSledgehammers"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingSledgehammers_ActionCoolDown"/>
            </triggered_effect>

            <triggered_effect trigger="onSelfScrapItem" action="LogMessageCVars, SCore" message="LBD DEBUG: Crafting Sledgehammers - Applying Cooldown (Scrap)">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingSledgehammers"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingSledgehammers_ActionCoolDown"/>
                <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfScrapItem" action="AddBuff" buff="buffLBD_craftingSledgehammers_ActionCoolDown">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingSledgehammers"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingSledgehammers_ActionCoolDown"/>
            </triggered_effect>

            <triggered_effect trigger="onSelfItemRepaired" action="LogMessageCVars, SCore" message="LBD DEBUG: Crafting Sledgehammers - Applying Cooldown (Repair)">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingSledgehammers"/>
                <requirement name="ItemPercentDamaged, SCore" operation="GTE" value="0.5"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingSledgehammers_ActionCoolDown"/>
                <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfItemRepaired" action="AddBuff" buff="buffLBD_craftingSledgehammers_ActionCoolDown">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingSledgehammers"/>
                <requirement name="ItemPercentDamaged, SCore" operation="GTE" value="0.5"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingSledgehammers_ActionCoolDown"/>
            </triggered_effect>

            <triggered_effect trigger="onSelfItemCrafted" action="LogMessageCVars, SCore" message="LBD DEBUG: Crafting Sledgehammers - Triggering Level Up Check (Craft)">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingSledgehammers"/>
                <requirement name="CVarCompare" cvar="$craftingsledgehammers_lbd_xp" operation="GTE" value="@$craftingsledgehammers_lbd_xptonext"/>
                <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfItemCrafted" action="AddBuff" buff="buffLBD_craftingSledgehammers_LevelUpCheck">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingSledgehammers"/>
                <requirement name="CVarCompare" cvar="$craftingsledgehammers_lbd_xp" operation="GTE" value="@$craftingsledgehammers_lbd_xptonext"/>
            </triggered_effect>

            <triggered_effect trigger="onSelfScrapItem" action="LogMessageCVars, SCore" message="LBD DEBUG: Crafting Sledgehammers - Triggering Level Up Check (Scrap)">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingSledgehammers"/>
                <requirement name="CVarCompare" cvar="$craftingsledgehammers_lbd_xp" operation="GTE" value="@$craftingsledgehammers_lbd_xptonext"/>
                <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfScrapItem" action="AddBuff" buff="buffLBD_craftingSledgehammers_LevelUpCheck">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingSledgehammers"/>
                <requirement name="CVarCompare" cvar="$craftingsledgehammers_lbd_xp" operation="GTE" value="@$craftingsledgehammers_lbd_xptonext"/>
            </triggered_effect>

            <triggered_effect trigger="onSelfItemRepaired" action="LogMessageCVars, SCore" message="LBD DEBUG: Crafting Sledgehammers - Triggering Level Up Check (Repair)">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingSledgehammers"/>
                <requirement name="ItemPercentDamaged, SCore" operation="GTE" value="0.5"/>
                <requirement name="CVarCompare" cvar="$craftingsledgehammers_lbd_xp" operation="GTE" value="@$craftingsledgehammers_lbd_xptonext"/>
                <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfItemRepaired" action="AddBuff" buff="buffLBD_craftingSledgehammers_LevelUpCheck">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingSledgehammers"/>
                <requirement name="ItemPercentDamaged, SCore" operation="GTE" value="0.5"/>
                <requirement name="CVarCompare" cvar="$craftingsledgehammers_lbd_xp" operation="GTE" value="@$craftingsledgehammers_lbd_xptonext"/>
            </triggered_effect>

            <!-- T0 starter gear. These items carry no UnlockedBy property, so the paths
                 above cannot see them, and below level 11 there is nothing else craftable -
                 vanilla unlocks the T1 recipes for this skill at 11. Pays until then and
                 stops, letting the UnlockedBy paths take over. Scrap is deliberately not
                 included: craft-then-scrap would loop for double XP. -->
            <triggered_effect trigger="onSelfItemCrafted" action="LogMessageCVars, SCore" message="LBD DEBUG: Crafting Sledgehammers - Attempting T0 Craft XP (+@$lbd_xp_crafting_base)">
                <requirement name="ProgressionLevel" progression_name="craftingSledgehammers" operation="LTE" value="10"/>
                <requirement name="ItemHasTags" tags="T0"/>
                <requirement name="ItemHasTags" tags="sledgeSkill"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingSledgehammers_T0RepairCoolDown"/>
                <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
                <requirement name="!RequirementCraftedItemMatchesCVar, SCore" cvar="$craftingsledgehammers_lbd_lastitem"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfItemCrafted" action="ModifyCVar" cvar="$craftingsledgehammers_lbd_xp" operation="add" value="@$lbd_xp_crafting_base">
                <requirement name="ProgressionLevel" progression_name="craftingSledgehammers" operation="LTE" value="10"/>
                <requirement name="ItemHasTags" tags="T0"/>
                <requirement name="ItemHasTags" tags="sledgeSkill"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingSledgehammers_T0RepairCoolDown"/>
                <requirement name="!RequirementCraftedItemMatchesCVar, SCore" cvar="$craftingsledgehammers_lbd_lastitem"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfItemRepaired" action="LogMessageCVars, SCore" message="LBD DEBUG: Crafting Sledgehammers - Attempting T0 Repair XP (+@$lbd_xp_repairing_base)">
                <requirement name="ProgressionLevel" progression_name="craftingSledgehammers" operation="LTE" value="10"/>
                <requirement name="ItemHasTags" tags="T0"/>
                <requirement name="ItemHasTags" tags="sledgeSkill"/>
                <requirement name="ItemPercentDamaged, SCore" operation="GTE" value="0.5"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingSledgehammers_T0RepairCoolDown"/>
                <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfItemRepaired" action="ModifyCVar" cvar="$craftingsledgehammers_lbd_xp" operation="add" value="@$lbd_xp_repairing_base">
                <requirement name="ProgressionLevel" progression_name="craftingSledgehammers" operation="LTE" value="10"/>
                <requirement name="ItemHasTags" tags="T0"/>
                <requirement name="ItemHasTags" tags="sledgeSkill"/>
                <requirement name="ItemPercentDamaged, SCore" operation="GTE" value="0.5"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingSledgehammers_T0RepairCoolDown"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfItemCrafted" action="AddBuff" buff="buffLBD_craftingSledgehammers_T0RepairCoolDown">
                <requirement name="ProgressionLevel" progression_name="craftingSledgehammers" operation="LTE" value="10"/>
                <requirement name="ItemHasTags" tags="T0"/>
                <requirement name="ItemHasTags" tags="sledgeSkill"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingSledgehammers_T0RepairCoolDown"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfItemRepaired" action="AddBuff" buff="buffLBD_craftingSledgehammers_T0RepairCoolDown">
                <requirement name="ProgressionLevel" progression_name="craftingSledgehammers" operation="LTE" value="10"/>
                <requirement name="ItemHasTags" tags="T0"/>
                <requirement name="ItemHasTags" tags="sledgeSkill"/>
                <requirement name="ItemPercentDamaged, SCore" operation="GTE" value="0.5"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingSledgehammers_T0RepairCoolDown"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfItemCrafted" action="LogMessageCVars, SCore" message="LBD DEBUG: Crafting Sledgehammers - Triggering Level Up Check (T0 Craft)">
                <requirement name="ProgressionLevel" progression_name="craftingSledgehammers" operation="LTE" value="10"/>
                <requirement name="ItemHasTags" tags="T0"/>
                <requirement name="ItemHasTags" tags="sledgeSkill"/>
                <requirement name="CVarCompare" cvar="$craftingsledgehammers_lbd_xp" operation="GTE" value="@$craftingsledgehammers_lbd_xptonext"/>
                <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfItemCrafted" action="AddBuff" buff="buffLBD_craftingSledgehammers_LevelUpCheck">
                <requirement name="ProgressionLevel" progression_name="craftingSledgehammers" operation="LTE" value="10"/>
                <requirement name="ItemHasTags" tags="T0"/>
                <requirement name="ItemHasTags" tags="sledgeSkill"/>
                <requirement name="CVarCompare" cvar="$craftingsledgehammers_lbd_xp" operation="GTE" value="@$craftingsledgehammers_lbd_xptonext"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfItemRepaired" action="AddBuff" buff="buffLBD_craftingSledgehammers_LevelUpCheck">
                <requirement name="ProgressionLevel" progression_name="craftingSledgehammers" operation="LTE" value="10"/>
                <requirement name="ItemHasTags" tags="T0"/>
                <requirement name="ItemHasTags" tags="sledgeSkill"/>
                <requirement name="ItemPercentDamaged, SCore" operation="GTE" value="0.5"/>
                <requirement name="CVarCompare" cvar="$craftingsledgehammers_lbd_xp" operation="GTE" value="@$craftingsledgehammers_lbd_xptonext"/>
            </triggered_effect>

            <!-- Remember what was just crafted. Ordered last so the awards above
                 compare against the PREVIOUS craft, not this one. A queue of twenty
                 identical items now scores once; twenty different items score twenty
                 times. A cooldown cannot make that distinction - when an item takes
                 longer to craft than the cooldown lasts, every craft in the queue
                 scores regardless. -->
            <triggered_effect trigger="onSelfItemCrafted" action="SetCVarFromItemType, SCore" cvar="$craftingsledgehammers_lbd_lastitem"/>

        </effect_group>

      
    </append>

    <append xpath="/buffs">
        <buff name="buffLBD_craftingSledgehammers_LevelUpCheck" hidden="true">
            <stack_type value="ignore"/><duration value="1"/>
            <effect_group>
                <requirement name="CanPurchasePerk, SCore" progression_name="craftingSledgehammers" />
                <triggered_effect trigger="onSelfBuffStart" action="LogMessageCVars, SCore" message="LBD DEBUG: Sledgehammers - Level Up SUCCESS (craftingSledgehammers)">
                    <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
                </triggered_effect>
                <triggered_effect trigger="onSelfBuffStart" action="AddProgressionLevel" progression_name="craftingSledgehammers" level="1"/>
                <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$craftingsledgehammers_lbd_xp" operation="subtract" value="@$craftingsledgehammers_lbd_xptonext"/>
                <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$craftingsledgehammers_lbd_xptonext" operation="multiply" value="@$lbd_xp_crafting_curve_multiplier"/>
                <triggered_effect trigger="onSelfBuffStart" action="ShowPerkLevelUp, SCore" perk="craftingsledgehammers" sound="read_skillbook_final" />
            </effect_group>
            <effect_group>
                <requirement name="!CanPurchasePerk, SCore" progression_name="craftingSledgehammers" />
                <triggered_effect trigger="onSelfBuffStart" action="LogMessageCVars, SCore" message="LBD DEBUG: Sledgehammers - Level Up FAILED. Perk is locked by requirements.">
                    <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
                </triggered_effect>
            </effect_group>
        </buff>

        <buff name="buffLBD_craftingSledgehammers_ActionCoolDown" hidden="true"><duration value="1"/></buff>

    
    </append>
    <append xpath="/buffs">
        <!-- Shared throttle for the T0 craft and repair paths. -->
        <buff name="buffLBD_craftingSledgehammers_T0RepairCoolDown" hidden="true"><duration value="5"/></buff>
    </append>
</configs>