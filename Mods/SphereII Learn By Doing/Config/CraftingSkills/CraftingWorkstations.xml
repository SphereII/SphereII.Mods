<configs>
    <append xpath="/buffs/buff[@name='buffLBD_IntellectManager']">
        <!--
            THE SALVAGE PATHS BELOW HAVE ONE BLOCK GATE, NOT TWO.

            They used to carry RequirementIsTargetBlock tags="workstationSkill" alongside
            BlockHasName. Requirements AND together, so both had to pass - and only the seven
            WORKING stations carry that tag: forge, workbench, cementMixer, chemistryStation,
            cntApiary, cntChickenCoop, cntDewCollector. The collapsed ones you actually find
            and strip in the world carry perkBookworm or challenge_mech_parts instead, so
            every one of them failed the tag and the salvage paths paid nothing. Measured in
            a play session: four collapsed workstations torn down, zero teardown awards, one
            XP for the whole run.

            BlockHasName alone is the gate now - the same thing Advanced Engineering uses on
            these blocks, which did fire. The term list is the skill's real scope, since
            craftingWorkstations unlocks forge, dew collector, apiary and chicken coop parts
            and not just the big three. 17 blocks, including every workstationSkill tagged
            one, with no false positives.
        -->
        <effect_group name="LBD Crafting Skill - Workstations">
            <triggered_effect trigger="onSelfItemCrafted" action="LogMessageCVars, SCore"
                              message="LBD DEBUG: Crafting Workstations - Attempting 'Craft' XP (+@$lbd_xp_crafting_base)">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingWorkstations"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingWorkstations_ActionCoolDown"/>
                <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
                <requirement name="!RequirementCraftedItemMatchesCVar, SCore" cvar="$craftingworkstations_lbd_lastitem"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfItemCrafted" action="ModifyCVar" cvar="$craftingworkstations_lbd_xp"
                              operation="add" value="@$lbd_xp_crafting_base">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingWorkstations"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingWorkstations_ActionCoolDown"/>
                <requirement name="!RequirementCraftedItemMatchesCVar, SCore" cvar="$craftingworkstations_lbd_lastitem"/>
            </triggered_effect>

            <triggered_effect trigger="onSelfScrapItem" action="LogMessageCVars, SCore"
                              message="LBD DEBUG: Crafting Workstations - Attempting 'Scrap' XP (+@$lbd_xp_scrapping_base)">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingWorkstations"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingWorkstations_ActionCoolDown"/>
                <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfScrapItem" action="ModifyCVar" cvar="$craftingworkstations_lbd_xp"
                              operation="add" value="@$lbd_xp_scrapping_base">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingWorkstations"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingWorkstations_ActionCoolDown"/>
            </triggered_effect>

            <triggered_effect trigger="onSelfPrimaryActionRayHit" action="LogMessageCVars, SCore"
                              message="LBD DEBUG: Crafting Workstations - Attempting 'Primary Hit Salvage' XP (+@$lbd_xp_salvaging_workstation_small_hit)">
                <requirement name="HoldingItemHasTags" tags="perkSalvageOperations"/>
                <requirement name="BlockHasName, SCore"
                             block_name="Forge*,Workbench*,ChemistryStation*,CementMixer*,DewCollector*,Apiary*,ChickenCoop*"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingWorkstations_HitCoolDown"/>
                <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfPrimaryActionRayHit" action="ModifyCVar"
                              cvar="$craftingworkstations_lbd_xp" operation="add"
                              value="@$lbd_xp_salvaging_workstation_small_hit">
                <requirement name="HoldingItemHasTags" tags="perkSalvageOperations"/>
                <requirement name="BlockHasName, SCore"
                             block_name="Forge*,Workbench*,ChemistryStation*,CementMixer*,DewCollector*,Apiary*,ChickenCoop*"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingWorkstations_HitCoolDown"/>
            </triggered_effect>

            <triggered_effect trigger="onSelfDestroyedBlock" action="LogMessageCVars, SCore"
                              message="LBD DEBUG: Crafting Workstations - Attempting 'Destroyed Block Salvage' XP (+@$lbd_xp_crafting_bigxp)">
                <requirement name="HoldingItemHasTags" tags="perkSalvageOperations"/>
                <requirement name="BlockHasName, SCore"
                             block_name="Forge*,Workbench*,ChemistryStation*,CementMixer*,DewCollector*,Apiary*,ChickenCoop*"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingWorkstations_ActionCoolDown"/>
                <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfDestroyedBlock" action="ModifyCVar" cvar="$craftingworkstations_lbd_xp"
                              operation="add" value="@$lbd_xp_crafting_bigxp">
                <requirement name="HoldingItemHasTags" tags="perkSalvageOperations"/>
                <requirement name="BlockHasName, SCore"
                             block_name="Forge*,Workbench*,ChemistryStation*,CementMixer*,DewCollector*,Apiary*,ChickenCoop*"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingWorkstations_ActionCoolDown"/>
            </triggered_effect>

            <triggered_effect trigger="onSelfItemCrafted" action="LogMessageCVars, SCore"
                              message="LBD DEBUG: Crafting Workstations - Applying Cooldown (Craft)">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingWorkstations"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingWorkstations_ActionCoolDown"/>
                <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfItemCrafted" action="AddBuff"
                              buff="buffLBD_craftingWorkstations_ActionCoolDown">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingWorkstations"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingWorkstations_ActionCoolDown"/>
            </triggered_effect>

            <triggered_effect trigger="onSelfScrapItem" action="LogMessageCVars, SCore"
                              message="LBD DEBUG: Crafting Workstations - Applying Cooldown (Scrap)">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingWorkstations"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingWorkstations_ActionCoolDown"/>
                <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfScrapItem" action="AddBuff"
                              buff="buffLBD_craftingWorkstations_ActionCoolDown">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingWorkstations"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingWorkstations_ActionCoolDown"/>
            </triggered_effect>

            <triggered_effect trigger="onSelfPrimaryActionRayHit" action="LogMessageCVars, SCore"
                              message="LBD DEBUG: Crafting Workstations - Applying Cooldown (Primary Hit Salvage)">
                <requirement name="HoldingItemHasTags" tags="perkSalvageOperations"/>
                <requirement name="BlockHasName, SCore"
                             block_name="Forge*,Workbench*,ChemistryStation*,CementMixer*,DewCollector*,Apiary*,ChickenCoop*"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingWorkstations_HitCoolDown"/>
                <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfPrimaryActionRayHit" action="AddBuff"
                              buff="buffLBD_craftingWorkstations_HitCoolDown">
                <requirement name="HoldingItemHasTags" tags="perkSalvageOperations"/>
                <requirement name="BlockHasName, SCore"
                             block_name="Forge*,Workbench*,ChemistryStation*,CementMixer*,DewCollector*,Apiary*,ChickenCoop*"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingWorkstations_HitCoolDown"/>
            </triggered_effect>

            <triggered_effect trigger="onSelfDestroyedBlock" action="LogMessageCVars, SCore"
                              message="LBD DEBUG: Crafting Workstations - Applying Cooldown (Destroyed Block Salvage)">
                <requirement name="HoldingItemHasTags" tags="perkSalvageOperations"/>
                <requirement name="BlockHasName, SCore"
                             block_name="Forge*,Workbench*,ChemistryStation*,CementMixer*,DewCollector*,Apiary*,ChickenCoop*"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingWorkstations_ActionCoolDown"/>
                <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfDestroyedBlock" action="AddBuff"
                              buff="buffLBD_craftingWorkstations_ActionCoolDown">
                <requirement name="HoldingItemHasTags" tags="perkSalvageOperations"/>
                <requirement name="BlockHasName, SCore"
                             block_name="Forge*,Workbench*,ChemistryStation*,CementMixer*,DewCollector*,Apiary*,ChickenCoop*"/>
                <requirement name="NotHasBuff" buff="buffLBD_craftingWorkstations_ActionCoolDown"/>
            </triggered_effect>

            <triggered_effect trigger="onSelfItemCrafted" action="LogMessageCVars, SCore"
                              message="LBD DEBUG: Crafting Workstations - Triggering Level Up Check (Craft)">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingWorkstations"/>
                <requirement name="CVarCompare" cvar="$craftingworkstations_lbd_xp" operation="GTE"
                             value="@$craftingworkstations_lbd_xptonext"/>
                <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfItemCrafted" action="AddBuff"
                              buff="buffLBD_craftingWorkstations_LevelUpCheck">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingWorkstations"/>
                <requirement name="CVarCompare" cvar="$craftingworkstations_lbd_xp" operation="GTE"
                             value="@$craftingworkstations_lbd_xptonext"/>
            </triggered_effect>

            <triggered_effect trigger="onSelfScrapItem" action="LogMessageCVars, SCore"
                              message="LBD DEBUG: Crafting Workstations - Triggering Level Up Check (Scrap)">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingWorkstations"/>
                <requirement name="CVarCompare" cvar="$craftingworkstations_lbd_xp" operation="GTE"
                             value="@$craftingworkstations_lbd_xptonext"/>
                <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfScrapItem" action="AddBuff"
                              buff="buffLBD_craftingWorkstations_LevelUpCheck">
                <requirement name="ItemHasProperty, SCore" property="UnlockedBy" prop_value="craftingWorkstations"/>
                <requirement name="CVarCompare" cvar="$craftingworkstations_lbd_xp" operation="GTE"
                             value="@$craftingworkstations_lbd_xptonext"/>
            </triggered_effect>

            <triggered_effect trigger="onSelfPrimaryActionRayHit" action="LogMessageCVars, SCore"
                              message="LBD DEBUG: Crafting Workstations - Triggering Level Up Check (Primary Hit Salvage)">
                <requirement name="HoldingItemHasTags" tags="perkSalvageOperations"/>
                <requirement name="BlockHasName, SCore"
                             block_name="Forge*,Workbench*,ChemistryStation*,CementMixer*,DewCollector*,Apiary*,ChickenCoop*"/>
                <requirement name="CVarCompare" cvar="$craftingworkstations_lbd_xp" operation="GTE"
                             value="@$craftingworkstations_lbd_xptonext"/>
                <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfPrimaryActionRayHit" action="AddBuff"
                              buff="buffLBD_craftingWorkstations_LevelUpCheck">
                <requirement name="HoldingItemHasTags" tags="perkSalvageOperations"/>
                <requirement name="BlockHasName, SCore"
                             block_name="Forge*,Workbench*,ChemistryStation*,CementMixer*,DewCollector*,Apiary*,ChickenCoop*"/>
                <requirement name="CVarCompare" cvar="$craftingworkstations_lbd_xp" operation="GTE"
                             value="@$craftingworkstations_lbd_xptonext"/>
            </triggered_effect>

            <triggered_effect trigger="onSelfDestroyedBlock" action="LogMessageCVars, SCore"
                              message="LBD DEBUG: Crafting Workstations - Triggering Level Up Check (Destroyed Block Salvage)">
                <requirement name="HoldingItemHasTags" tags="perkSalvageOperations"/>
                <requirement name="BlockHasName, SCore"
                             block_name="Forge*,Workbench*,ChemistryStation*,CementMixer*,DewCollector*,Apiary*,ChickenCoop*"/>
                <requirement name="CVarCompare" cvar="$craftingworkstations_lbd_xp" operation="GTE"
                             value="@$craftingworkstations_lbd_xptonext"/>
                <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
            </triggered_effect>
            <triggered_effect trigger="onSelfDestroyedBlock" action="AddBuff"
                              buff="buffLBD_craftingWorkstations_LevelUpCheck">
                <requirement name="HoldingItemHasTags" tags="perkSalvageOperations"/>
                <requirement name="BlockHasName, SCore"
                             block_name="Forge*,Workbench*,ChemistryStation*,CementMixer*,DewCollector*,Apiary*,ChickenCoop*"/>
                <requirement name="CVarCompare" cvar="$craftingworkstations_lbd_xp" operation="GTE"
                             value="@$craftingworkstations_lbd_xptonext"/>
            </triggered_effect>
            <!-- Remember what was just crafted. Ordered last so the awards above
                 compare against the PREVIOUS craft, not this one. A queue of twenty
                 identical items now scores once; twenty different items score twenty
                 times. A cooldown cannot make that distinction - when an item takes
                 longer to craft than the cooldown lasts, every craft in the queue
                 scores regardless. -->
            <triggered_effect trigger="onSelfItemCrafted" action="SetCVarFromItemType, SCore" cvar="$craftingworkstations_lbd_lastitem"/>

        </effect_group>


    </append>

    <append xpath="/buffs">
        <buff name="buffLBD_craftingWorkstations_LevelUpCheck" hidden="true">
            <stack_type value="ignore"/>
            <duration value="1"/>
            <effect_group>
                <requirement name="CanPurchasePerk, SCore" progression_name="craftingWorkstations"/>
                <triggered_effect trigger="onSelfBuffStart" action="LogMessageCVars, SCore" message="LBD DEBUG: Workstations - Level Up SUCCESS (craftingWorkstations)">
                    <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
                </triggered_effect>
                <triggered_effect trigger="onSelfBuffStart" action="AddProgressionLevel"
                                  progression_name="craftingWorkstations" level="1"/>
                <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$craftingworkstations_lbd_xp"
                                  operation="subtract" value="@$craftingworkstations_lbd_xptonext"/>
                <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar"
                                  cvar="$craftingworkstations_lbd_xptonext" operation="multiply"
                                  value="@$lbd_xp_crafting_curve_multiplier"/>
                <triggered_effect trigger="onSelfBuffStart" action="ShowPerkLevelUp, SCore" perk="craftingWorkstations"
                                  sound="read_skillbook_final"/>
            </effect_group>
            <effect_group>
                <requirement name="!CanPurchasePerk, SCore" progression_name="craftingWorkstations"/>
                <triggered_effect trigger="onSelfBuffStart" action="LogMessageCVars, SCore"
                                  message="LBD DEBUG: Workstations - Level Up FAILED. Perk is locked by requirements.">
                    <requirement name="CVarCompare" cvar="$lbd_debug" operation="GTE" value="1"/>
                </triggered_effect>
            </effect_group>
        </buff>

        <buff name="buffLBD_craftingWorkstations_ActionCoolDown" hidden="true">
            <duration value="1"/>
        </buff>

        <buff name="buffLBD_craftingWorkstations_HitCoolDown" hidden="true">
            <duration value="5"/>
        </buff>

    </append>
</configs>