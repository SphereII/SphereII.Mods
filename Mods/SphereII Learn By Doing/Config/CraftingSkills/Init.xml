<configs>
    <!-- This file will be included by the main buffs.xml after LBD_Global_Init.xml -->
    <append xpath="/buffs/buff[@name='ProgressionLearnByDoing_Init']">
        <effect_group name="Crafting LBD Settings">
            <!-- Global XP values for crafting actions -->
            <!-- Crafting skills run to 75 or 100 levels, so they cannot share the global
                 1.2 curve, which is sized for a five level perk. At 1.2 from a start of 5 the
                 ladder was broken at both ends: level 1 cost five crafts, so any casual burst
                 of crafting handed over a level or two, while level 75 wanted 21.7 million and
                 level 100 two billion. At a start of 20 and a 1.04 curve, level 1 is twenty
                 crafts, level 10 - where the T0 paths stop paying - is 240 cumulative, level 75
                 is 8,973 and level 100 is 24,752. Perks and attributes keep the 1.2 curve. -->
            <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$lbd_xp_crafting_curve_multiplier" operation="set" value="1.04"/>
            <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$lbd_xp_crafting_base" operation="set" value="1"/> <!-- XP for crafting an item -->
            <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$lbd_xp_scrapping_base" operation="set" value="1"/> <!-- XP for scrapping an item -->
            <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$lbd_xp_repairing_base" operation="set" value="1"/> <!-- XP for repairing an item -->
            <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$lbd_xp_bigXP_base" operation="set" value="10"/> <!-- XP for repairing an item -->

            <!-- Harvesting -->
            <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$craftingharvestingtools_lbd_xp" operation="set" value="0"/>
            <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$craftingharvestingtools_lbd_xptonext" operation="set" value="20"/>

            <!-- Repairing -->
            <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$craftingrepairtools_lbd_xp" operation="set" value="0"/>
            <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$craftingrepairtools_lbd_xptonext" operation="set" value="20"/>

            <!-- Salvage Tools -->
            <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$craftingsalvagetools_lbd_xp" operation="set" value="0"/>
            <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$craftingsalvagetools_lbd_xptonext" operation="set" value="20"/>

            <!-- Knuckles -->
            <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$craftingknuckles_lbd_xp" operation="set" value="0"/>
            <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$craftingknuckles_lbd_xptonext" operation="set" value="20"/>

            <!-- Knives -->
            <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$craftingblades_lbd_xp" operation="set" value="0"/>
            <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$craftingblades_lbd_xptonext" operation="set" value="20"/>
            
            <!-- Clubs -->
            <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$craftingclubs_lbd_xp" operation="set" value="0"/>
            <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$craftingclubs_lbd_xptonext" operation="set" value="20"/>

            <!-- Sledge Hammers -->
            <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$craftingsledgehammers_lbd_xp" operation="set" value="0"/>
            <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$craftingsledgehammers_lbd_xptonext" operation="set" value="20"/>

            <!-- Crafting Bows -->
            <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$craftingbows_lbd_xp" operation="set" value="0"/>
            <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$craftingbows_lbd_xptonext" operation="set" value="20"/>
            
            <!-- Crafting Spears -->
            <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$craftingspears_lbd_xp" operation="set" value="0"/>
            <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$craftingspears_lbd_xptonext" operation="set" value="20"/>

            <!-- Hand Guns -->
            <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$craftinghandguns_lbd_xp" operation="set" value="0"/>
            <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$craftinghandguns_lbd_xptonext" operation="set" value="20"/>

            <!-- Shot guns -->
            <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$craftingshotguns_lbd_xp" operation="set" value="0"/>
            <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$craftingshotguns_lbd_xptonext" operation="set" value="20"/>
            
            <!-- Rifles -->
            <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$craftingrifles_lbd_xp" operation="set" value="0"/>
            <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$craftingrifles_lbd_xptonext" operation="set" value="20"/>
            
            <!-- Machine Guns -->
            <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$craftingmachineguns_lbd_xp" operation="set" value="0"/>
            <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$craftingmachineguns_lbd_xptonext" operation="set" value="20"/>
            
            <!-- Explosives -->
            <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$craftingexplosives_lbd_xp" operation="set" value="0"/>
            <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$craftingexplosives_lbd_xptonext" operation="set" value="20"/>
            
            <!-- Robotics -->
            <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$craftingrobotics_lbd_xp" operation="set" value="0"/>
            <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$craftingrobotics_lbd_xptonext" operation="set" value="20"/>

            <!-- Armor -->
            <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$craftingarmor_lbd_xp" operation="set" value="0"/>
            <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$craftingarmor_lbd_xptonext" operation="set" value="20"/>
             <!-- Medical -->
            <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$craftingmedical_lbd_xp" operation="set" value="0"/>
            <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$craftingmedical_lbd_xptonext" operation="set" value="20"/>
            
            <!-- Food -->
            <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$craftingfood_lbd_xp" operation="set" value="0"/>
            <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$craftingfood_lbd_xptonext" operation="set" value="20"/>
            
            <!-- Seeds -->
            <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$craftingseeds_lbd_xp" operation="set" value="0"/>
            <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$craftingseeds_lbd_xptonext" operation="set" value="20"/>
            <!-- Both seed payouts were referenced by CraftingSeeds.xml but never defined,
                 and an unset cvar reads as 0, so craftingSeeds was the one skill in the
                 mod with no working XP path at all. Small seeds match the generic
                 $lbd_xp_crafting_base of 1; the large-crop seeds pay double. -->
            <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$lbd_xp_crafting_seed_small_base" operation="set" value="1"/>
            <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$lbd_xp_crafting_seed_large_base" operation="set" value="2"/>

            <!-- Electrician -->
            <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$craftingelectrician_lbd_xp" operation="set" value="0"/>
            <!-- Electrician starts at double the other crafting skills. It is the only one
                 fed by salvage on a broad tag: RequirementIsTargetBlock matches 956 blocks
                 for it - every light, appliance, AC unit, breaker box and vehicle that
                 yields electric parts - against 7 for Traps and 3 for Workstations. A
                 measured session ran at 10 XP a minute while wrenching, which put level 1
                 two minutes away and the level 25 recipe unlock at 83. At 40 those become
                 four minutes and just under three hours. The other 22 crafting skills stay
                 at 20; they are gated by materials rather than by how much of a POI is
                 electrical. -->
            <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$craftingelectrician_lbd_xptonext" operation="set" value="40"/>
            
            <!-- Traps -->
            <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$craftingtraps_lbd_xp" operation="set" value="0"/>
            <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$craftingtraps_lbd_xptonext" operation="set" value="20"/>
            
            <!-- Workstations -->
            <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$lbd_xp_salvaging_workstation_base" operation="set" value="1"/>
            <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$lbd_xp_crafting_bigxp" operation="set" value="10"/>
            <!-- Per-hit payout while salvaging a workstation block, as opposed to the
                 $lbd_xp_crafting_bigxp of 10 paid once the block is destroyed. Referenced
                 by CraftingWorkstations.xml but never defined, so those hits scored 0.
                 Kept at 1: the hit is throttled by buffLBD_craftingWorkstations_HitCoolDown
                 and repeats many times per block. -->
            <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$lbd_xp_salvaging_workstation_small_hit" operation="set" value="1"/>
            <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$craftingworkstations_lbd_xp" operation="set" value="0"/>
            <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$craftingworkstations_lbd_xptonext" operation="set" value="20"/>
            <!-- Vehicles -->
            <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$craftingvehicles_lbd_xp" operation="set" value="0"/>
            <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$craftingvehicles_lbd_xptonext" operation="set" value="20"/>
        </effect_group>
    </append>
</configs>